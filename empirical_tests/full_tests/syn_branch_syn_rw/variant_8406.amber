};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(set = 0, binding = 2) buffer Checker {
 uint checker[];
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 _GLF_struct_20 _GLF_struct_replacement_20 = _GLF_struct_20(gl_SubgroupID, _GLF_struct_18(bvec3(true), _GLF_struct_17(mat3x4(1.0), ivec2(1), ivec3(1), uvec4(1u)), bvec3(true), uvec2(1u)), _GLF_struct_19(mat4x3(1.0)), mat2(1.0), mat3x4(1.0));
 uint subgroup_size = gl_SubgroupSize;
 uint subgroup_local_id = gl_SubgroupInvocationID;
 _GLF_struct_24 _GLF_struct_replacement_24 = _GLF_struct_24(_GLF_struct_23(true, gl_NumWorkGroups.x, uvec4(1u), mat3(1.0), _GLF_struct_21(vec2(1.0), mat3x2(1.0)), _GLF_struct_22(1, mat3x2(1.0), uvec2(1u), mat3(1.0), bvec4(true), mat4x2(1.0), mat3(1.0))), 1u);
 uint workgroup_size = gl_WorkGroupSize.x;
 _GLF_struct_5 _GLF_struct_replacement_5 = _GLF_struct_5(_GLF_struct_1(_GLF_struct_0(ivec4(1), mat4x2(1.0), mat3x2(1.0), uvec3(1u), bvec3(true), mat4x3(1.0), vec4(1.0))), gl_WorkGroupID.x, mat2x4(1.0), bvec4(true), mat2(1.0), 1, _GLF_struct_4(mat2(1.0), mat4x3(1.0), _GLF_struct_2(mat3(1.0), mat2x4(1.0), 1, 1.0, 1.0), mat4(1.0), 1, _GLF_struct_3(mat2x4(1.0), mat3x4(1.0), mat2x3(1.0), mat2x4(1.0), mat4x3(1.0)), mat3x4(1.0)), vec3(1.0));
 uint workgroup_base = workgroup_size * _GLF_struct_replacement_5.workgroup_id;
 _GLF_struct_29 _GLF_struct_replacement_29 = _GLF_struct_29(_GLF_struct_25(mat2x4(1.0), _GLF_struct_replacement_20.subgroup_id * subgroup_size, 1.0, ivec4(1)), vec2(1.0), vec2(1.0), bvec3(true), _GLF_struct_28(mat4(1.0), _GLF_struct_26(1.0, uvec2(1u), 1.0, 1u), _GLF_struct_27(bvec2(true), bvec3(true)), 1.0), mat2(1.0), 1);
 _GLF_struct_16 _GLF_struct_replacement_16 = _GLF_struct_16(mat2(1.0), mat3x2(1.0), _GLF_struct_10(_GLF_struct_6(ivec2(1), uvec4(1u)), 1u, _GLF_struct_7(mat2(1.0), mat2(1.0), 1u, uvec3(1u), mat3x2(1.0), vec3(1.0)), _GLF_struct_8(mat4x2(1.0), mat2x3(1.0)), _GLF_struct_9(uvec2(1u), workgroup_base + _GLF_struct_replacement_29._f0.subgroup_base + subgroup_local_id, uvec2(1u), mat3x2(1.0))), 1, bvec4(true), mat4x3(1.0), _GLF_struct_15(_GLF_struct_11(uvec3(1u), mat4(1.0), uvec2(1u), vec4(1.0), mat3x2(1.0), vec3(1.0), vec3(1.0)), _GLF_struct_12(mat4x2(1.0), mat2x4(1.0), mat3x2(1.0)), _GLF_struct_13(ivec3(1), mat3x4(1.0), mat3x2(1.0)), _GLF_struct_14(mat4x2(1.0), mat3x2(1.0), mat3x2(1.0), bvec3(true), 1, mat3x2(1.0))));
 uint next_virtual_gid = workgroup_base + _GLF_struct_replacement_29._f0.subgroup_base + ((subgroup_local_id + 1) % subgroup_size);
 uint read = atomicLoad(buf[_GLF_struct_replacement_16._f2._f4.virtual_gid], 3, 64, 2);
 if((subgroup_local_id % 2) == 0)
  {
   atomicStore(buf[next_virtual_gid], uint(1), 3, 64, 4);
  }
 else
  {
   atomicStore(buf[next_virtual_gid], uint(1), 3, 64, 4);
  }
 subgroupBarrier();
 atomicStore(checker[_GLF_struct_replacement_16._f2._f4.virtual_gid], read, 3, 64, 4);
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 2
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END
BUFFER checker DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected_checker DATA_TYPE uint32 SIZE 8388096 FILL 0

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 
  BIND BUFFER checker AS storage DESCRIPTOR_SET 0 BINDING 2 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT checker EQ_BUFFER expected_checker
