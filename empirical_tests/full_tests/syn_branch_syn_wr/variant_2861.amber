#!amber

DEVICE_FEATURE SubgroupSizeControl.subgroupSizeControl

SET ENGINE_DATA fence_timeout_ms 10000

SHADER compute test GLSL
#version 460

#ifndef REDUCER
#define _GLF_ZERO(X, Y)                   (Y)
#define _GLF_ONE(X, Y)                    (Y)
#define _GLF_FALSE(X, Y)                  (Y)
#define _GLF_TRUE(X, Y)                   (Y)
#define _GLF_IDENTITY(X, Y)               (Y)
#define _GLF_DEAD(X)                      (X)
#define _GLF_FUZZED(X)                    (X)
#define _GLF_WRAPPED_LOOP(X)              X
#define _GLF_WRAPPED_IF_TRUE(X)           X
#define _GLF_WRAPPED_IF_FALSE(X)          X
#define _GLF_SWITCH(X)                    X
#define _GLF_MAKE_IN_BOUNDS_INT(IDX, SZ)  clamp(IDX, 0, SZ - 1)
#define _GLF_MAKE_IN_BOUNDS_UINT(IDX, SZ) clamp(IDX, 0u, SZ - 1u)
#endif


struct _GLF_struct_10 {
 uint workgroup_id;
 uvec2 _f0;
} ;

struct _GLF_struct_8 {
 mat4x2 _f0;
} ;

struct _GLF_struct_6 {
 int _f0;
 vec4 _f1;
 uvec2 _f2;
} ;

struct _GLF_struct_5 {
 uint _f0;
 mat4x3 _f1;
 int _f2;
} ;

struct _GLF_struct_4 {
 mat4x2 _f0;
 mat3x4 _f1;
 bvec2 _f2;
 mat2 _f3;
 uvec4 _f4;
 float _f5;
 mat2x3 _f6;
} ;

struct _GLF_struct_7 {
 _GLF_struct_4 _f0;
 ivec4 _f1;
 _GLF_struct_5 _f2;
 uvec4 _f3;
 _GLF_struct_6 _f4;
} ;

struct _GLF_struct_2 {
 mat3 _f0;
 ivec3 _f1;
 mat2x3 _f2;
 int _f3;
 bvec2 _f4;
 bvec3 _f5;
} ;

struct _GLF_struct_1 {
 mat4x3 _f0;
 mat3x4 _f1;
} ;

struct _GLF_struct_0 {
 mat2x4 _f0;
 bvec2 _f1;
} ;

struct _GLF_struct_3 {
 uint _f0;
 _GLF_struct_0 _f1;
 _GLF_struct_1 _f2;
 _GLF_struct_2 _f3;
 bvec2 _f4;
 vec4 _f5;
 bvec2 _f6;
} ;

struct _GLF_struct_9 {
 _GLF_struct_3 _f0;
 _GLF_struct_7 _f1;
 int _f2;
 uint subgroup_base;
 ivec3 _f3;
 _GLF_struct_8 _f4;
} ;

layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(set = 0, binding = 2) buffer Checker {
 uint checker[];
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 uint subgroup_id = gl_SubgroupID;
 uint subgroup_size = gl_SubgroupSize;
 uint subgroup_local_id = gl_SubgroupInvocationID;
 uint num_workgroup = gl_NumWorkGroups.x;
 uint workgroup_size = gl_WorkGroupSize.x;
 _GLF_struct_10 _GLF_struct_replacement_10 = _GLF_struct_10(gl_WorkGroupID.x, uvec2(1u));
 uint workgroup_base = workgroup_size * _GLF_struct_replacement_10.workgroup_id;
 _GLF_struct_9 _GLF_struct_replacement_9 = _GLF_struct_9(_GLF_struct_3(1u, _GLF_struct_0(mat2x4(1.0), bvec2(true)), _GLF_struct_1(mat4x3(1.0), mat3x4(1.0)), _GLF_struct_2(mat3(1.0), ivec3(1), mat2x3(1.0), 1, bvec2(true), bvec3(true)), bvec2(true), vec4(1.0), bvec2(true)), _GLF_struct_7(_GLF_struct_4(mat4x2(1.0), mat3x4(1.0), bvec2(true), mat2(1.0), uvec4(1u), 1.0, mat2x3(1.0)), ivec4(1), _GLF_struct_5(1u, mat4x3(1.0), 1), uvec4(1u), _GLF_struct_6(1, vec4(1.0), uvec2(1u))), 1, subgroup_id * subgroup_size, ivec3(1), _GLF_struct_8(mat4x2(1.0)));
 uint virtual_gid = workgroup_base + _GLF_struct_replacement_9.subgroup_base + subgroup_local_id;
 uint next_virtual_gid = workgroup_base + _GLF_struct_replacement_9.subgroup_base + ((subgroup_local_id + 1) % subgroup_size);
 uint read = 0;
 atomicStore(buf[next_virtual_gid], uint(1), 3, 64, 4);
 if((subgroup_local_id % 2) == 0)
  {
   read = atomicLoad(buf[virtual_gid], 3, 64, 2);
  }
 else
  {
   switch(_GLF_SWITCH(0))
    {
     case 46:
     (uvec4(167146u, 100509u, 36326u, 18513u) << uvec4(172596u, 85689u, 95557u, 176128u)).t;
     case 0:
     case 54:
     case 44:
     case 22:
     case 73:
     case 12:
     read = atomicLoad(buf[virtual_gid], 3, 64, 2);
     break;
     default:
     1;
    }
  }
 subgroupBarrier();
 atomicStore(checker[virtual_gid], read, 3, 64, 4);
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 2
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END
BUFFER checker DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected_checker DATA_TYPE uint32 SIZE 8388096 FILL 1

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 
  BIND BUFFER checker AS storage DESCRIPTOR_SET 0 BINDING 2 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT checker EQ_BUFFER expected_checker
