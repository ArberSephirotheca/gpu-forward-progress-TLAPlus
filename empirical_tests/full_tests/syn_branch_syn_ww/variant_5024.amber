} ;

struct _GLF_struct_18 {
 uint virtual_gid;
 int _f0;
 _GLF_struct_8 _f1;
 _GLF_struct_14 _f2;
 float _f3;
 _GLF_struct_16 _f4;
 _GLF_struct_17 _f5;
} ;

