} ;

layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 uint subgroup_id = gl_SubgroupID;
 _GLF_struct_5 _GLF_struct_replacement_5 = _GLF_struct_5(mat2x4(1.0), _GLF_struct_2(_GLF_struct_0(bvec4(true), mat3x2(1.0), ivec2(1), true), ivec3(1), mat4x3(1.0), _GLF_struct_1(vec4(1.0), bvec2(true), mat2x3(1.0))), vec3(1.0), mat2(1.0), mat3x2(1.0), _GLF_struct_4(gl_SubgroupSize, _GLF_struct_3(mat4(1.0))), mat2x3(1.0));
 uint subgroup_local_id = gl_SubgroupInvocationID;
 uint num_workgroup = gl_NumWorkGroups.x;
 uint workgroup_size = gl_WorkGroupSize.x;
 uint workgroup_id = gl_WorkGroupID.x;
 uint workgroup_base = workgroup_size * workgroup_id;
 uint subgroup_base = subgroup_id * _GLF_struct_replacement_5._f5.subgroup_size;
 _GLF_struct_18 _GLF_struct_replacement_18 = _GLF_struct_18(workgroup_base + subgroup_base + subgroup_local_id, 1, _GLF_struct_8(_GLF_struct_6(mat2(1.0)), mat3x2(1.0), mat3x4(1.0), _GLF_struct_7(ivec3(1), vec4(1.0), 1.0, mat4(1.0), vec3(1.0), mat3x2(1.0)), ivec2(1)), _GLF_struct_14(_GLF_struct_9(1), _GLF_struct_10(1u, mat2(1.0), 1, mat4x3(1.0), mat4(1.0), mat3(1.0)), _GLF_struct_11(mat4x2(1.0), mat4(1.0), uvec2(1u), bvec3(true)), _GLF_struct_12(uvec4(1u)), vec3(1.0), _GLF_struct_13(uvec4(1u), mat3(1.0), mat4x2(1.0), vec4(1.0), mat3(1.0), ivec4(1), true), mat3x2(1.0)), 1.0, _GLF_struct_16(_GLF_struct_15(ivec3(1), mat4x2(1.0), 1u, 1u), uvec2(1u)), _GLF_struct_17(bvec4(true)));
 uint next_virtual_gid = workgroup_base + subgroup_base + ((subgroup_local_id + 1) % _GLF_struct_replacement_5._f5.subgroup_size);
 atomicStore(buf[_GLF_struct_replacement_18.virtual_gid], uint(1), 3, 64, 4);
 if((subgroup_local_id % 2) == 0)
  {
   atomicStore(buf[next_virtual_gid], uint(2), 3, 64, 4);
  }
 else
  {
   atomicStore(buf[next_virtual_gid], uint(2), 3, 64, 4);
  }
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 2
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT tester EQ_BUFFER expected
