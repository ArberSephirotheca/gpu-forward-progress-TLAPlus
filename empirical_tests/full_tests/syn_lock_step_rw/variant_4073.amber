#!amber

DEVICE_FEATURE SubgroupSizeControl.subgroupSizeControl

SET ENGINE_DATA fence_timeout_ms 10000

SHADER compute test GLSL
#version 460
struct _GLF_struct_20 {
 uint _f0;
 vec4 _f1;
 uint num_workgroup;
} ;

struct _GLF_struct_18 {
 float _f0;
} ;

struct _GLF_struct_16 {
 ivec2 _f0;
 mat3 _f1;
 mat2x4 _f2;
 mat3x2 _f3;
 int _f4;
} ;

struct _GLF_struct_15 {
 mat2x3 _f0;
 bvec3 _f1;
 bvec3 _f2;
 ivec4 _f3;
 ivec3 _f4;
 vec4 _f5;
 bvec2 _f6;
} ;

struct _GLF_struct_14 {
 mat2x3 _f0;
 mat4x2 _f1;
 uint _f2;
 ivec4 _f3;
 bool _f4;
} ;

struct _GLF_struct_17 {
 _GLF_struct_14 _f0;
 uint workgroup_base;
 _GLF_struct_15 _f1;
 _GLF_struct_16 _f2;
 float _f3;
 mat2 _f4;
 bool _f5;
} ;

struct _GLF_struct_13 {
 mat4x3 _f0;
} ;

struct _GLF_struct_12 {
 uvec4 _f0;
 mat4 _f1;
} ;

struct _GLF_struct_19 {
 uvec3 _f0;
 _GLF_struct_12 _f1;
 _GLF_struct_13 _f2;
 vec2 _f3;
 vec2 _f4;
 _GLF_struct_17 _f5;
 _GLF_struct_18 _f6;
} ;

struct _GLF_struct_9 {
 mat2x4 _f0;
 mat2 _f1;
 uint virtual_gid;
} ;

struct _GLF_struct_10 {
 uvec3 _f0;
 vec4 _f1;
 mat2 _f2;
 mat3 _f3;
 _GLF_struct_9 _f4;
} ;

struct _GLF_struct_7 {
 vec2 _f0;
} ;

struct _GLF_struct_6 {
 bvec2 _f0;
 ivec4 _f1;
 mat3x2 _f2;
 mat3 _f3;
} ;

struct _GLF_struct_5 {
 vec4 _f0;
 ivec4 _f1;
} ;

struct _GLF_struct_4 {
 bvec2 _f0;
 uint _f1;
 mat2 _f2;
 ivec3 _f3;
 ivec4 _f4;
 mat3 _f5;
} ;

struct _GLF_struct_8 {
 _GLF_struct_4 _f0;
 mat2 _f1;
 _GLF_struct_5 _f2;
 uint _f3;
 _GLF_struct_6 _f4;
 _GLF_struct_7 _f5;
 mat4x3 _f6;
} ;

struct _GLF_struct_11 {
 _GLF_struct_8 _f0;
 _GLF_struct_10 _f1;
 ivec2 _f2;
} ;

struct _GLF_struct_1 {
 mat4 _f0;
 bvec4 _f1;
 uvec4 _f2;
 mat3x4 _f3;
} ;

struct _GLF_struct_0 {
 mat3x4 _f0;
 bool _f1;
 uvec3 _f2;
 mat4x3 _f3;
} ;

struct _GLF_struct_2 {
 ivec3 _f0;
 _GLF_struct_0 _f1;
 mat3x4 _f2;
 _GLF_struct_1 _f3;
} ;

struct _GLF_struct_3 {
 mat2x3 _f0;
 mat2x3 _f1;
 uvec2 _f2;
 _GLF_struct_2 _f3;
 uvec2 _f4;
 bvec2 _f5;
 uint workgroup_size;
} ;

layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(set = 0, binding = 2) buffer Checker {
 uint checker[];
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 uint subgroup_id = gl_SubgroupID;
 uint subgroup_size = gl_SubgroupSize;
 uint subgroup_local_id = gl_SubgroupInvocationID;
 _GLF_struct_20 _GLF_struct_replacement_20 = _GLF_struct_20(1u, vec4(1.0), gl_NumWorkGroups.x);
 _GLF_struct_3 _GLF_struct_replacement_3 = _GLF_struct_3(mat2x3(1.0), mat2x3(1.0), uvec2(1u), _GLF_struct_2(ivec3(1), _GLF_struct_0(mat3x4(1.0), true, uvec3(1u), mat4x3(1.0)), mat3x4(1.0), _GLF_struct_1(mat4(1.0), bvec4(true), uvec4(1u), mat3x4(1.0))), uvec2(1u), bvec2(true), gl_WorkGroupSize.x);
 uint workgroup_id = gl_WorkGroupID.x;
 _GLF_struct_19 _GLF_struct_replacement_19 = _GLF_struct_19(uvec3(1u), _GLF_struct_12(uvec4(1u), mat4(1.0)), _GLF_struct_13(mat4x3(1.0)), vec2(1.0), vec2(1.0), _GLF_struct_17(_GLF_struct_14(mat2x3(1.0), mat4x2(1.0), 1u, ivec4(1), true), _GLF_struct_replacement_3.workgroup_size * workgroup_id, _GLF_struct_15(mat2x3(1.0), bvec3(true), bvec3(true), ivec4(1), ivec3(1), vec4(1.0), bvec2(true)), _GLF_struct_16(ivec2(1), mat3(1.0), mat2x4(1.0), mat3x2(1.0), 1), 1.0, mat2(1.0), true), _GLF_struct_18(1.0));
 uint subgroup_base = subgroup_id * subgroup_size;
 _GLF_struct_11 _GLF_struct_replacement_11 = _GLF_struct_11(_GLF_struct_8(_GLF_struct_4(bvec2(true), 1u, mat2(1.0), ivec3(1), ivec4(1), mat3(1.0)), mat2(1.0), _GLF_struct_5(vec4(1.0), ivec4(1)), 1u, _GLF_struct_6(bvec2(true), ivec4(1), mat3x2(1.0), mat3(1.0)), _GLF_struct_7(vec2(1.0)), mat4x3(1.0)), _GLF_struct_10(uvec3(1u), vec4(1.0), mat2(1.0), mat3(1.0), _GLF_struct_9(mat2x4(1.0), mat2(1.0), _GLF_struct_replacement_19._f5.workgroup_base + subgroup_base + subgroup_local_id)), ivec2(1));
 uint next_virtual_gid = _GLF_struct_replacement_19._f5.workgroup_base + subgroup_base + ((subgroup_local_id + 1) % subgroup_size);
 uint read = atomicLoad(buf[_GLF_struct_replacement_11._f1._f4.virtual_gid], 3, 64, 2);
 atomicStore(buf[next_virtual_gid], uint(1), 3, 64, 4);
 subgroupBarrier();
 atomicStore(checker[_GLF_struct_replacement_11._f1._f4.virtual_gid], read, 3, 64, 4);
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 2
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END
BUFFER checker DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected_checker DATA_TYPE uint32 SIZE 8388096 FILL 0

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 
  BIND BUFFER checker AS storage DESCRIPTOR_SET 0 BINDING 2 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT checker EQ_BUFFER expected_checker
