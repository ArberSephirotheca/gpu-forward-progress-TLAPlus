#!amber

DEVICE_FEATURE SubgroupSizeControl.subgroupSizeControl

SET ENGINE_DATA fence_timeout_ms 10000

SHADER compute test GLSL
#version 460
struct _GLF_struct_20 {
 uvec2 _f0;
 mat4x3 _f1;
 uvec3 _f2;
 mat4x2 _f3;
} ;

struct _GLF_struct_21 {
 _GLF_struct_20 _f0;
 mat4x3 _f1;
 bvec4 _f2;
} ;

struct _GLF_struct_22 {
 uint subgroup_base;
 _GLF_struct_21 _f0;
} ;

struct _GLF_struct_17 {
 mat3 _f0;
 uvec3 _f1;
 mat2x3 _f2;
 vec3 _f3;
 ivec4 _f4;
} ;

struct _GLF_struct_16 {
 uvec4 _f0;
 float _f1;
 uint _f2;
} ;

struct _GLF_struct_18 {
 _GLF_struct_16 _f0;
 uvec3 _f1;
 _GLF_struct_17 _f2;
} ;

struct _GLF_struct_14 {
 uvec3 _f0;
 mat4x2 _f1;
} ;

struct _GLF_struct_15 {
 uint _f0;
 mat2x4 _f1;
 mat2 _f2;
 _GLF_struct_14 _f3;
} ;

struct _GLF_struct_12 {
 bool _f0;
} ;

struct _GLF_struct_11 {
 ivec4 _f0;
 mat3 _f1;
} ;

struct _GLF_struct_10 {
 uvec2 _f0;
 uint _f1;
} ;

struct _GLF_struct_9 {
 mat2x3 _f0;
 bool _f1;
} ;

struct _GLF_struct_13 {
 vec3 _f0;
 _GLF_struct_9 _f1;
 _GLF_struct_10 _f2;
 mat4 _f3;
 _GLF_struct_11 _f4;
 bvec4 _f5;
 _GLF_struct_12 _f6;
} ;

struct _GLF_struct_7 {
 mat3x2 _f0;
 uint workgroup_base;
 mat2 _f1;
 mat2 _f2;
} ;

struct _GLF_struct_8 {
 ivec4 _f0;
 uint _f1;
 _GLF_struct_7 _f2;
} ;

struct _GLF_struct_19 {
 _GLF_struct_8 _f0;
 _GLF_struct_13 _f1;
 _GLF_struct_15 _f2;
 uint _f3;
 _GLF_struct_18 _f4;
} ;

struct _GLF_struct_4 {
 ivec3 _f0;
 mat4x2 _f1;
 int _f2;
 mat3x4 _f3;
 mat4x3 _f4;
} ;

struct _GLF_struct_3 {
 bool _f0;
} ;

struct _GLF_struct_5 {
 mat4x3 _f0;
 mat2x4 _f1;
 _GLF_struct_3 _f2;
 _GLF_struct_4 _f3;
 bool _f4;
 mat3x2 _f5;
} ;

struct _GLF_struct_1 {
 mat3x4 _f0;
 mat4 _f1;
 mat4x3 _f2;
 uvec4 _f3;
} ;

struct _GLF_struct_0 {
 uvec2 _f0;
 mat4 _f1;
 mat2 _f2;
 mat2x4 _f3;
} ;

struct _GLF_struct_2 {
 mat4x2 _f0;
 _GLF_struct_0 _f1;
 _GLF_struct_1 _f2;
} ;

struct _GLF_struct_6 {
 _GLF_struct_2 _f0;
 _GLF_struct_5 _f1;
 ivec4 _f2;
 uint subgroup_local_id;
} ;

layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(set = 0, binding = 2) buffer Checker {
 uint checker[];
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 uint subgroup_id = gl_SubgroupID;
 uint subgroup_size = gl_SubgroupSize;
 _GLF_struct_6 _GLF_struct_replacement_6 = _GLF_struct_6(_GLF_struct_2(mat4x2(1.0), _GLF_struct_0(uvec2(1u), mat4(1.0), mat2(1.0), mat2x4(1.0)), _GLF_struct_1(mat3x4(1.0), mat4(1.0), mat4x3(1.0), uvec4(1u))), _GLF_struct_5(mat4x3(1.0), mat2x4(1.0), _GLF_struct_3(true), _GLF_struct_4(ivec3(1), mat4x2(1.0), 1, mat3x4(1.0), mat4x3(1.0)), true, mat3x2(1.0)), ivec4(1), gl_SubgroupInvocationID);
 uint num_workgroup = gl_NumWorkGroups.x;
 uint workgroup_size = gl_WorkGroupSize.x;
 uint workgroup_id = gl_WorkGroupID.x;
 _GLF_struct_19 _GLF_struct_replacement_19 = _GLF_struct_19(_GLF_struct_8(ivec4(1), 1u, _GLF_struct_7(mat3x2(1.0), workgroup_size * workgroup_id, mat2(1.0), mat2(1.0))), _GLF_struct_13(vec3(1.0), _GLF_struct_9(mat2x3(1.0), true), _GLF_struct_10(uvec2(1u), 1u), mat4(1.0), _GLF_struct_11(ivec4(1), mat3(1.0)), bvec4(true), _GLF_struct_12(true)), _GLF_struct_15(1u, mat2x4(1.0), mat2(1.0), _GLF_struct_14(uvec3(1u), mat4x2(1.0))), 1u, _GLF_struct_18(_GLF_struct_16(uvec4(1u), 1.0, 1u), uvec3(1u), _GLF_struct_17(mat3(1.0), uvec3(1u), mat2x3(1.0), vec3(1.0), ivec4(1))));
 _GLF_struct_22 _GLF_struct_replacement_22 = _GLF_struct_22(subgroup_id * subgroup_size, _GLF_struct_21(_GLF_struct_20(uvec2(1u), mat4x3(1.0), uvec3(1u), mat4x2(1.0)), mat4x3(1.0), bvec4(true)));
 uint virtual_gid = _GLF_struct_replacement_19._f0._f2.workgroup_base + _GLF_struct_replacement_22.subgroup_base + _GLF_struct_replacement_6.subgroup_local_id;
 uint next_virtual_gid = _GLF_struct_replacement_19._f0._f2.workgroup_base + _GLF_struct_replacement_22.subgroup_base + ((_GLF_struct_replacement_6.subgroup_local_id + 1) % subgroup_size);
 atomicStore(buf[next_virtual_gid], uint(1), 3, 64, 4);
 uint read = atomicLoad(buf[virtual_gid], 3, 64, 2);
 subgroupBarrier();
 atomicStore(checker[virtual_gid], read, 3, 64, 4);
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 2
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END
BUFFER checker DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected_checker DATA_TYPE uint32 SIZE 8388096 FILL 1

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 
  BIND BUFFER checker AS storage DESCRIPTOR_SET 0 BINDING 2 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT checker EQ_BUFFER expected_checker
