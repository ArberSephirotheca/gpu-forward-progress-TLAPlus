#!amber

DEVICE_FEATURE SubgroupSizeControl.subgroupSizeControl

SET ENGINE_DATA fence_timeout_ms 10000

SHADER compute test GLSL
#version 460

#ifndef REDUCER
#define _GLF_ZERO(X, Y)                   (Y)
#define _GLF_ONE(X, Y)                    (Y)
#define _GLF_FALSE(X, Y)                  (Y)
#define _GLF_TRUE(X, Y)                   (Y)
#define _GLF_IDENTITY(X, Y)               (Y)
#define _GLF_DEAD(X)                      (X)
#define _GLF_FUZZED(X)                    (X)
#define _GLF_WRAPPED_LOOP(X)              X
#define _GLF_WRAPPED_IF_TRUE(X)           X
#define _GLF_WRAPPED_IF_FALSE(X)          X
#define _GLF_SWITCH(X)                    X
#define _GLF_MAKE_IN_BOUNDS_INT(IDX, SZ)  clamp(IDX, 0, SZ - 1)
#define _GLF_MAKE_IN_BOUNDS_UINT(IDX, SZ) clamp(IDX, 0u, SZ - 1u)
#endif


layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(set = 0, binding = 2) buffer Checker {
 uint checker[];
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 uvec4 GLF_merged4_0_1_16_1_1_13_2_1_14_3_1_14next_virtual_gidnum_workgroupworkgroup_baseworkgroup_size;
 uvec4 GLF_merged4_0_1_4_1_1_17_2_1_13_3_1_11readsubgroup_local_idsubgroup_sizevirtual_gid;
 uvec4 GLF_merged4_0_1_16_1_1_13_2_1_13_3_1_11next_virtual_gidnum_workgroupsubgroup_basesubgroup_id;
 uint subgroup_id = gl_SubgroupID;
 GLF_merged4_0_1_16_1_1_13_2_1_13_3_1_11next_virtual_gidnum_workgroupsubgroup_basesubgroup_id.w = subgroup_id;
 uint subgroup_size = gl_SubgroupSize;
 GLF_merged4_0_1_4_1_1_17_2_1_13_3_1_11readsubgroup_local_idsubgroup_sizevirtual_gid.z = subgroup_size;
 uint subgroup_local_id = gl_SubgroupInvocationID;
 GLF_merged4_0_1_4_1_1_17_2_1_13_3_1_11readsubgroup_local_idsubgroup_sizevirtual_gid.y = subgroup_local_id;
 uint num_workgroup = gl_NumWorkGroups.x;
 GLF_merged4_0_1_16_1_1_13_2_1_14_3_1_14next_virtual_gidnum_workgroupworkgroup_baseworkgroup_size.y = num_workgroup;
 GLF_merged4_0_1_16_1_1_13_2_1_13_3_1_11next_virtual_gidnum_workgroupsubgroup_basesubgroup_id.y = GLF_merged4_0_1_16_1_1_13_2_1_14_3_1_14next_virtual_gidnum_workgroupworkgroup_baseworkgroup_size.y;
 uint workgroup_size = gl_WorkGroupSize.x;
 GLF_merged4_0_1_16_1_1_13_2_1_14_3_1_14next_virtual_gidnum_workgroupworkgroup_baseworkgroup_size.w = workgroup_size;
 uint workgroup_id = gl_WorkGroupID.x;
 uint workgroup_base = GLF_merged4_0_1_16_1_1_13_2_1_14_3_1_14next_virtual_gidnum_workgroupworkgroup_baseworkgroup_size.w * workgroup_id;
 GLF_merged4_0_1_16_1_1_13_2_1_14_3_1_14next_virtual_gidnum_workgroupworkgroup_baseworkgroup_size.z = workgroup_base;
 uint subgroup_base = GLF_merged4_0_1_16_1_1_13_2_1_13_3_1_11next_virtual_gidnum_workgroupsubgroup_basesubgroup_id.w * GLF_merged4_0_1_4_1_1_17_2_1_13_3_1_11readsubgroup_local_idsubgroup_sizevirtual_gid.z;
 GLF_merged4_0_1_16_1_1_13_2_1_13_3_1_11next_virtual_gidnum_workgroupsubgroup_basesubgroup_id.z = subgroup_base;
 uint virtual_gid = _GLF_IDENTITY(GLF_merged4_0_1_16_1_1_13_2_1_14_3_1_14next_virtual_gidnum_workgroupworkgroup_baseworkgroup_size.z + GLF_merged4_0_1_16_1_1_13_2_1_13_3_1_11next_virtual_gidnum_workgroupsubgroup_basesubgroup_id.z, (GLF_merged4_0_1_16_1_1_13_2_1_14_3_1_14next_virtual_gidnum_workgroupworkgroup_baseworkgroup_size.z + GLF_merged4_0_1_16_1_1_13_2_1_13_3_1_11next_virtual_gidnum_workgroupsubgroup_basesubgroup_id.z) | (0u << _GLF_IDENTITY(uint(6u), uint(6u)))) + GLF_merged4_0_1_4_1_1_17_2_1_13_3_1_11readsubgroup_local_idsubgroup_sizevirtual_gid.y;
 GLF_merged4_0_1_4_1_1_17_2_1_13_3_1_11readsubgroup_local_idsubgroup_sizevirtual_gid.w = virtual_gid;
 uint next_virtual_gid = GLF_merged4_0_1_16_1_1_13_2_1_14_3_1_14next_virtual_gidnum_workgroupworkgroup_baseworkgroup_size.z + GLF_merged4_0_1_16_1_1_13_2_1_13_3_1_11next_virtual_gidnum_workgroupsubgroup_basesubgroup_id.z + ((GLF_merged4_0_1_4_1_1_17_2_1_13_3_1_11readsubgroup_local_idsubgroup_sizevirtual_gid.y + 1) % GLF_merged4_0_1_4_1_1_17_2_1_13_3_1_11readsubgroup_local_idsubgroup_sizevirtual_gid.z);
 GLF_merged4_0_1_16_1_1_13_2_1_14_3_1_14next_virtual_gidnum_workgroupworkgroup_baseworkgroup_size.x = next_virtual_gid;
