 atomicStore(buf[GLF_merged4_0_1_16_1_1_13_2_1_13_3_1_11next_virtual_gidnum_workgroupsubgroup_basesubgroup_id.x], uint(1), 3, 64, 4);
 uint read = atomicLoad(buf[GLF_merged4_0_1_4_1_1_17_2_1_13_3_1_11readsubgroup_local_idsubgroup_sizevirtual_gid.w], 3, 64, 2);
 GLF_merged4_0_1_4_1_1_17_2_1_13_3_1_11readsubgroup_local_idsubgroup_sizevirtual_gid.x = read;
 subgroupBarrier();
 atomicStore(checker[GLF_merged4_0_1_4_1_1_17_2_1_13_3_1_11readsubgroup_local_idsubgroup_sizevirtual_gid.w], GLF_merged4_0_1_4_1_1_17_2_1_13_3_1_11readsubgroup_local_idsubgroup_sizevirtual_gid.x, 3, 64, 4);
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 2
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END
BUFFER checker DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected_checker DATA_TYPE uint32 SIZE 8388096 FILL 1

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 
  BIND BUFFER checker AS storage DESCRIPTOR_SET 0 BINDING 2 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT checker EQ_BUFFER expected_checker
