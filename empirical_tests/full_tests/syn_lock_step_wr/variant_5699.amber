#!amber

DEVICE_FEATURE SubgroupSizeControl.subgroupSizeControl

SET ENGINE_DATA fence_timeout_ms 10000

SHADER compute test GLSL
#version 460

#ifndef REDUCER
#define _GLF_ZERO(X, Y)                   (Y)
#define _GLF_ONE(X, Y)                    (Y)
#define _GLF_FALSE(X, Y)                  (Y)
#define _GLF_TRUE(X, Y)                   (Y)
#define _GLF_IDENTITY(X, Y)               (Y)
#define _GLF_DEAD(X)                      (X)
#define _GLF_FUZZED(X)                    (X)
#define _GLF_WRAPPED_LOOP(X)              X
#define _GLF_WRAPPED_IF_TRUE(X)           X
#define _GLF_WRAPPED_IF_FALSE(X)          X
#define _GLF_SWITCH(X)                    X
#define _GLF_MAKE_IN_BOUNDS_INT(IDX, SZ)  clamp(IDX, 0, SZ - 1)
#define _GLF_MAKE_IN_BOUNDS_UINT(IDX, SZ) clamp(IDX, 0u, SZ - 1u)
#endif


struct _GLF_struct_12 {
 ivec3 _f0;
 mat2x3 _f1;
 ivec3 _f2;
 mat4x3 _f3;
 float _f4;
} ;

struct _GLF_struct_13 {
 _GLF_struct_12 _f0;
 bvec3 _f1;
} ;

struct _GLF_struct_10 {
 mat4x2 _f0;
 ivec3 _f1;
 ivec2 _f2;
} ;

struct _GLF_struct_9 {
 mat4x3 _f0;
 uvec2 _f1;
 mat4 _f2;
 bvec2 _f3;
 mat3x2 _f4;
 uvec3 _f5;
} ;

struct _GLF_struct_11 {
 int _f0;
 vec3 _f1;
 _GLF_struct_9 _f2;
 _GLF_struct_10 _f3;
 bvec3 _f4;
 mat4x3 _f5;
 vec4 _f6;
} ;

struct _GLF_struct_14 {
 _GLF_struct_11 _f0;
 _GLF_struct_13 _f1;
 vec4 _f2;
 ivec4 _f3;
 uvec2 _f4;
 float _f5;
 uint read;
} ;

struct _GLF_struct_6 {
 mat3x4 _f0;
 uvec2 _f1;
} ;

struct _GLF_struct_5 {
 uvec2 _f0;
 vec2 _f1;
 mat3x2 _f2;
 uvec4 _f3;
} ;

struct _GLF_struct_7 {
 mat4 _f0;
 _GLF_struct_5 _f1;
 bvec2 _f2;
 mat4 _f3;
 _GLF_struct_6 _f4;
 mat3x2 _f5;
} ;

struct _GLF_struct_3 {
 ivec2 _f0;
 uvec4 _f1;
 uint subgroup_size;
 uvec3 _f2;
 mat3 _f3;
 ivec2 _f4;
} ;

struct _GLF_struct_2 {
 bool _f0;
 mat2x3 _f1;
 mat3 _f2;
 bool _f3;
 mat4 _f4;
} ;

struct _GLF_struct_4 {
 _GLF_struct_2 _f0;
 float _f1;
 int _f2;
 _GLF_struct_3 _f3;
 uvec4 _f4;
 mat3x2 _f5;
 bool _f6;
} ;

struct _GLF_struct_0 {
 int _f0;
} ;

struct _GLF_struct_1 {
 _GLF_struct_0 _f0;
 mat4 _f1;
 float _f2;
} ;

struct _GLF_struct_8 {
 mat4x2 _f0;
 int _f1;
 _GLF_struct_1 _f2;
 _GLF_struct_4 _f3;
 _GLF_struct_7 _f4;
 int _f5;
} ;

layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(set = 0, binding = 2) buffer Checker {
 uint checker[];
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 uint subgroup_id = gl_SubgroupID;
 _GLF_struct_8 _GLF_struct_replacement_8 = _GLF_struct_8(mat4x2(1.0), 1, _GLF_struct_1(_GLF_struct_0(1), mat4(1.0), 1.0), _GLF_struct_4(_GLF_struct_2(true, mat2x3(1.0), mat3(1.0), true, mat4(1.0)), 1.0, 1, _GLF_struct_3(ivec2(1), uvec4(1u), gl_SubgroupSize, uvec3(1u), mat3(1.0), ivec2(1)), uvec4(1u), mat3x2(1.0), true), _GLF_struct_7(mat4(1.0), _GLF_struct_5(uvec2(1u), vec2(1.0), mat3x2(1.0), uvec4(1u)), bvec2(true), mat4(1.0), _GLF_struct_6(mat3x4(1.0), uvec2(1u)), mat3x2(1.0)), 1);
 uint subgroup_local_id = gl_SubgroupInvocationID;
 uint num_workgroup = gl_NumWorkGroups.x;
 uint workgroup_size = gl_WorkGroupSize.x;
 uint workgroup_id = gl_WorkGroupID.x;
 uint workgroup_base = workgroup_size * workgroup_id;
 uint subgroup_base = subgroup_id * _GLF_struct_replacement_8._f3._f3.subgroup_size;
 uint virtual_gid = workgroup_base + subgroup_base + subgroup_local_id;
 uint next_virtual_gid = workgroup_base + subgroup_base + ((subgroup_local_id + 1) % _GLF_struct_replacement_8._f3._f3.subgroup_size);
 if(_GLF_WRAPPED_IF_TRUE(true))
  {
   atomicStore(buf[next_virtual_gid], uint(1), 3, 64, 4);
  }
 else
  {
  }
 _GLF_struct_14 _GLF_struct_replacement_14 = _GLF_struct_14(_GLF_struct_11(1, vec3(1.0), _GLF_struct_9(mat4x3(1.0), uvec2(1u), mat4(1.0), bvec2(true), mat3x2(1.0), uvec3(1u)), _GLF_struct_10(mat4x2(1.0), ivec3(1), ivec2(1)), bvec3(true), mat4x3(1.0), vec4(1.0)), _GLF_struct_13(_GLF_struct_12(ivec3(1), mat2x3(1.0), ivec3(1), mat4x3(1.0), 1.0), bvec3(true)), vec4(1.0), ivec4(1), uvec2(1u), 1.0, atomicLoad(buf[virtual_gid], 3, 64, 2));
 subgroupBarrier();
 atomicStore(checker[virtual_gid], _GLF_struct_replacement_14.read, 3, 64, 4);
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 2
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END
BUFFER checker DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected_checker DATA_TYPE uint32 SIZE 8388096 FILL 1

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 
  BIND BUFFER checker AS storage DESCRIPTOR_SET 0 BINDING 2 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT checker EQ_BUFFER expected_checker
