 _GLF_struct_12 _f5;
 _GLF_struct_14 _f6;
} ;

struct _GLF_struct_1 {
 vec4 _f0;
 mat2x4 _f1;
 mat2 _f2;
 bvec2 _f3;
 mat3 _f4;
 bvec2 _f5;
 bool _f6;
} ;

struct _GLF_struct_0 {
