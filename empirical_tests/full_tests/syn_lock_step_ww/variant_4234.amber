#!amber

DEVICE_FEATURE SubgroupSizeControl.subgroupSizeControl

SET ENGINE_DATA fence_timeout_ms 10000

SHADER compute test GLSL
#version 460
struct _GLF_struct_14 {
 mat3x2 _f0;
 bvec2 _f1;
 vec2 _f2;
 ivec4 _f3;
 mat2x3 _f4;
 ivec2 _f5;
 uvec2 _f6;
} ;

struct _GLF_struct_13 {
 vec2 _f0;
 uint _f1;
 mat3x4 _f2;
 uvec4 _f3;
 ivec2 _f4;
 mat4x2 _f5;
} ;

struct _GLF_struct_12 {
 bvec4 _f0;
 uvec3 _f1;
 float _f2;
 mat3x2 _f3;
 bool _f4;
 mat3x4 _f5;
 mat3x2 _f6;
} ;

struct _GLF_struct_11 {
 vec2 _f0;
} ;

struct _GLF_struct_15 {
 mat2x4 _f0;
 _GLF_struct_11 _f1;
 _GLF_struct_12 _f2;
 _GLF_struct_13 _f3;
 _GLF_struct_14 _f4;
} ;

struct _GLF_struct_16 {
 uint subgroup_local_id;
 mat3 _f0;
 bvec3 _f1;
 _GLF_struct_15 _f2;
 uvec3 _f3;
} ;

struct _GLF_struct_8 {
 bool _f0;
 ivec3 _f1;
} ;

struct _GLF_struct_9 {
 uint virtual_gid;
 _GLF_struct_8 _f0;
 uvec2 _f1;
} ;

struct _GLF_struct_10 {
 _GLF_struct_9 _f0;
} ;

struct _GLF_struct_6 {
 uint _f0;
} ;

struct _GLF_struct_7 {
 ivec2 _f0;
 uint subgroup_base;
 _GLF_struct_6 _f1;
 bvec3 _f2;
} ;

struct _GLF_struct_4 {
 uvec3 _f0;
} ;

struct _GLF_struct_2 {
 vec4 _f0;
 vec4 _f1;
 uvec4 _f2;
 mat4x2 _f3;
} ;

struct _GLF_struct_1 {
 uint _f0;
 ivec2 _f1;
 uvec3 _f2;
 uint _f3;
 mat2 _f4;
 mat3x2 _f5;
 bvec3 _f6;
} ;

struct _GLF_struct_0 {
 mat4x2 _f0;
 mat3 _f1;
 mat3x2 _f2;
 mat3x2 _f3;
 mat4 _f4;
 mat2x4 _f5;
} ;

struct _GLF_struct_3 {
 bvec3 _f0;
 mat2x3 _f1;
 uvec3 _f2;
 mat4x3 _f3;
 _GLF_struct_0 _f4;
 _GLF_struct_1 _f5;
 _GLF_struct_2 _f6;
} ;

struct _GLF_struct_5 {
 vec4 _f0;
 _GLF_struct_3 _f1;
 float _f2;
 _GLF_struct_4 _f3;
 bvec4 _f4;
 mat4 _f5;
 uint workgroup_id;
 uvec2 _f6;
} ;

layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 uint subgroup_id = gl_SubgroupID;
 uint subgroup_size = gl_SubgroupSize;
 _GLF_struct_16 _GLF_struct_replacement_16 = _GLF_struct_16(gl_SubgroupInvocationID, mat3(1.0), bvec3(true), _GLF_struct_15(mat2x4(1.0), _GLF_struct_11(vec2(1.0)), _GLF_struct_12(bvec4(true), uvec3(1u), 1.0, mat3x2(1.0), true, mat3x4(1.0), mat3x2(1.0)), _GLF_struct_13(vec2(1.0), 1u, mat3x4(1.0), uvec4(1u), ivec2(1), mat4x2(1.0)), _GLF_struct_14(mat3x2(1.0), bvec2(true), vec2(1.0), ivec4(1), mat2x3(1.0), ivec2(1), uvec2(1u))), uvec3(1u));
 uint num_workgroup = gl_NumWorkGroups.x;
 uint workgroup_size = gl_WorkGroupSize.x;
 _GLF_struct_5 _GLF_struct_replacement_5 = _GLF_struct_5(vec4(1.0), _GLF_struct_3(bvec3(true), mat2x3(1.0), uvec3(1u), mat4x3(1.0), _GLF_struct_0(mat4x2(1.0), mat3(1.0), mat3x2(1.0), mat3x2(1.0), mat4(1.0), mat2x4(1.0)), _GLF_struct_1(1u, ivec2(1), uvec3(1u), 1u, mat2(1.0), mat3x2(1.0), bvec3(true)), _GLF_struct_2(vec4(1.0), vec4(1.0), uvec4(1u), mat4x2(1.0))), 1.0, _GLF_struct_4(uvec3(1u)), bvec4(true), mat4(1.0), gl_WorkGroupID.x, uvec2(1u));
 uint workgroup_base = workgroup_size * _GLF_struct_replacement_5.workgroup_id;
 _GLF_struct_7 _GLF_struct_replacement_7 = _GLF_struct_7(ivec2(1), subgroup_id * subgroup_size, _GLF_struct_6(1u), bvec3(true));
 _GLF_struct_10 _GLF_struct_replacement_10 = _GLF_struct_10(_GLF_struct_9(workgroup_base + _GLF_struct_replacement_7.subgroup_base + _GLF_struct_replacement_16.subgroup_local_id, _GLF_struct_8(true, ivec3(1)), uvec2(1u)));
 uint next_virtual_gid = workgroup_base + _GLF_struct_replacement_7.subgroup_base + ((_GLF_struct_replacement_16.subgroup_local_id + 1) % subgroup_size);
 atomicStore(buf[_GLF_struct_replacement_10._f0.virtual_gid], uint(1), 3, 64, 4);
 atomicStore(buf[next_virtual_gid], uint(2), 3, 64, 4);
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 2
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT tester EQ_BUFFER expected
