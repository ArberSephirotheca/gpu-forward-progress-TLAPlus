#!amber

DEVICE_FEATURE SubgroupSizeControl.subgroupSizeControl

SET ENGINE_DATA fence_timeout_ms 10000

SHADER compute test GLSL
#version 460
struct _GLF_struct_16 {
 mat4 _f0;
} ;

struct _GLF_struct_14 {
 bvec2 _f0;
 uvec2 _f1;
} ;

struct _GLF_struct_13 {
 mat2 _f0;
 bvec4 _f1;
 uvec3 _f2;
 ivec2 _f3;
} ;

struct _GLF_struct_12 {
 float _f0;
 uvec4 _f1;
 vec3 _f2;
 int _f3;
 bvec2 _f4;
 bvec3 _f5;
} ;

struct _GLF_struct_15 {
 _GLF_struct_12 _f0;
 _GLF_struct_13 _f1;
 _GLF_struct_14 _f2;
} ;

struct _GLF_struct_10 {
 bvec2 _f0;
 int _f1;
 ivec4 _f2;
 mat2 _f3;
 uint _f4;
} ;

struct _GLF_struct_11 {
 _GLF_struct_10 _f0;
} ;

struct _GLF_struct_8 {
 ivec2 _f0;
 uvec2 _f1;
 uint subgroup_id;
 ivec3 _f2;
 bvec2 _f3;
 bool _f4;
} ;

struct _GLF_struct_7 {
 mat2x4 _f0;
 ivec3 _f1;
 float _f2;
 bvec4 _f3;
 mat4 _f4;
} ;

struct _GLF_struct_6 {
 mat2x3 _f0;
 bvec2 _f1;
 ivec3 _f2;
 vec2 _f3;
 uvec4 _f4;
} ;

struct _GLF_struct_9 {
 bvec4 _f0;
 uvec4 _f1;
 bool _f2;
 _GLF_struct_6 _f3;
 _GLF_struct_7 _f4;
 _GLF_struct_8 _f5;
 mat3x2 _f6;
} ;

struct _GLF_struct_17 {
 float _f0;
 mat3x4 _f1;
 _GLF_struct_9 _f2;
 uvec4 _f3;
 _GLF_struct_11 _f4;
 _GLF_struct_15 _f5;
 _GLF_struct_16 _f6;
} ;

struct _GLF_struct_5 {
 uint num_workgroup;
 mat2x3 _f0;
} ;

struct _GLF_struct_3 {
 bvec4 _f0;
 mat2x4 _f1;
} ;

struct _GLF_struct_1 {
 uvec2 _f0;
 ivec4 _f1;
 vec4 _f2;
} ;

struct _GLF_struct_2 {
 ivec2 _f0;
 _GLF_struct_1 _f1;
 ivec2 _f2;
 bvec4 _f3;
} ;

struct _GLF_struct_0 {
 uvec2 _f0;
} ;

struct _GLF_struct_4 {
 bvec2 _f0;
 _GLF_struct_0 _f1;
 _GLF_struct_2 _f2;
 uint subgroup_size;
 _GLF_struct_3 _f3;
} ;

layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 _GLF_struct_17 _GLF_struct_replacement_17 = _GLF_struct_17(1.0, mat3x4(1.0), _GLF_struct_9(bvec4(true), uvec4(1u), true, _GLF_struct_6(mat2x3(1.0), bvec2(true), ivec3(1), vec2(1.0), uvec4(1u)), _GLF_struct_7(mat2x4(1.0), ivec3(1), 1.0, bvec4(true), mat4(1.0)), _GLF_struct_8(ivec2(1), uvec2(1u), gl_SubgroupID, ivec3(1), bvec2(true), true), mat3x2(1.0)), uvec4(1u), _GLF_struct_11(_GLF_struct_10(bvec2(true), 1, ivec4(1), mat2(1.0), 1u)), _GLF_struct_15(_GLF_struct_12(1.0, uvec4(1u), vec3(1.0), 1, bvec2(true), bvec3(true)), _GLF_struct_13(mat2(1.0), bvec4(true), uvec3(1u), ivec2(1)), _GLF_struct_14(bvec2(true), uvec2(1u))), _GLF_struct_16(mat4(1.0)));
 _GLF_struct_4 _GLF_struct_replacement_4 = _GLF_struct_4(bvec2(true), _GLF_struct_0(uvec2(1u)), _GLF_struct_2(ivec2(1), _GLF_struct_1(uvec2(1u), ivec4(1), vec4(1.0)), ivec2(1), bvec4(true)), gl_SubgroupSize, _GLF_struct_3(bvec4(true), mat2x4(1.0)));
 uint subgroup_local_id = gl_SubgroupInvocationID;
 _GLF_struct_5 _GLF_struct_replacement_5 = _GLF_struct_5(gl_NumWorkGroups.x, mat2x3(1.0));
 uint workgroup_size = gl_WorkGroupSize.x;
 uint workgroup_id = gl_WorkGroupID.x;
 uint workgroup_base = workgroup_size * workgroup_id;
 uint subgroup_base = _GLF_struct_replacement_17._f2._f5.subgroup_id * _GLF_struct_replacement_4.subgroup_size;
 uint virtual_gid = workgroup_base + subgroup_base + subgroup_local_id;
 uint next_virtual_gid = workgroup_base + subgroup_base + ((subgroup_local_id + 1) % _GLF_struct_replacement_4.subgroup_size);
 atomicStore(buf[virtual_gid], uint(1), 3, 64, 4);
 atomicStore(buf[next_virtual_gid], uint(2), 3, 64, 4);
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 2
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT tester EQ_BUFFER expected
