#!amber

DEVICE_FEATURE SubgroupSizeControl.subgroupSizeControl

SET ENGINE_DATA fence_timeout_ms 10000

SHADER compute test GLSL
#version 460
struct _GLF_struct_12 {
 ivec3 _f0;
 bvec4 _f1;
 vec2 _f2;
 float _f3;
 mat2x4 _f4;
 mat3 _f5;
 uint workgroup_id;
 float _f6;
} ;

struct _GLF_struct_13 {
 uvec4 _f0;
 mat2x3 _f1;
 _GLF_struct_12 _f2;
 mat2x4 _f3;
 mat4 _f4;
} ;

struct _GLF_struct_14 {
 uvec3 _f0;
 mat4x3 _f1;
 _GLF_struct_13 _f2;
 mat4x2 _f3;
 float _f4;
 uvec4 _f5;
 ivec3 _f6;
} ;

struct _GLF_struct_9 {
 bvec3 _f0;
 mat3x4 _f1;
 bool _f2;
} ;

struct _GLF_struct_8 {
 mat4x2 _f0;
 mat2 _f1;
 float _f2;
 mat2 _f3;
 bvec2 _f4;
 mat4 _f5;
 bvec2 _f6;
} ;

struct _GLF_struct_10 {
 _GLF_struct_8 _f0;
 mat2 _f1;
 ivec2 _f2;
 bvec4 _f3;
 _GLF_struct_9 _f4;
 bvec2 _f5;
 mat2x3 _f6;
} ;

struct _GLF_struct_6 {
 vec3 _f0;
 mat4x2 _f1;
 ivec3 _f2;
 uvec2 _f3;
 mat3x4 _f4;
 mat4x3 _f5;
} ;

struct _GLF_struct_7 {
 _GLF_struct_6 _f0;
} ;

struct _GLF_struct_4 {
 mat4x2 _f0;
 ivec4 _f1;
} ;

struct _GLF_struct_3 {
 bvec3 _f0;
 ivec2 _f1;
 mat2 _f2;
 mat2x4 _f3;
 int _f4;
 bool _f5;
} ;

struct _GLF_struct_5 {
 _GLF_struct_3 _f0;
 ivec4 _f1;
 _GLF_struct_4 _f2;
} ;

struct _GLF_struct_2 {
 mat3x2 _f0;
 mat2 _f1;
} ;

struct _GLF_struct_0 {
 int _f0;
 mat2 _f1;
 mat3x2 _f2;
} ;

struct _GLF_struct_1 {
 bvec2 _f0;
 ivec3 _f1;
 _GLF_struct_0 _f2;
} ;

struct _GLF_struct_11 {
 _GLF_struct_1 _f0;
 _GLF_struct_2 _f1;
 _GLF_struct_5 _f2;
 _GLF_struct_7 _f3;
 uint num_workgroup;
 vec2 _f4;
 _GLF_struct_10 _f5;
} ;

layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 uint subgroup_id = gl_SubgroupID;
 uint subgroup_size = gl_SubgroupSize;
 uint subgroup_local_id = gl_SubgroupInvocationID;
 _GLF_struct_11 _GLF_struct_replacement_11 = _GLF_struct_11(_GLF_struct_1(bvec2(true), ivec3(1), _GLF_struct_0(1, mat2(1.0), mat3x2(1.0))), _GLF_struct_2(mat3x2(1.0), mat2(1.0)), _GLF_struct_5(_GLF_struct_3(bvec3(true), ivec2(1), mat2(1.0), mat2x4(1.0), 1, true), ivec4(1), _GLF_struct_4(mat4x2(1.0), ivec4(1))), _GLF_struct_7(_GLF_struct_6(vec3(1.0), mat4x2(1.0), ivec3(1), uvec2(1u), mat3x4(1.0), mat4x3(1.0))), gl_NumWorkGroups.x, vec2(1.0), _GLF_struct_10(_GLF_struct_8(mat4x2(1.0), mat2(1.0), 1.0, mat2(1.0), bvec2(true), mat4(1.0), bvec2(true)), mat2(1.0), ivec2(1), bvec4(true), _GLF_struct_9(bvec3(true), mat3x4(1.0), true), bvec2(true), mat2x3(1.0)));
 uint workgroup_size = gl_WorkGroupSize.x;
 _GLF_struct_14 _GLF_struct_replacement_14 = _GLF_struct_14(uvec3(1u), mat4x3(1.0), _GLF_struct_13(uvec4(1u), mat2x3(1.0), _GLF_struct_12(ivec3(1), bvec4(true), vec2(1.0), 1.0, mat2x4(1.0), mat3(1.0), gl_WorkGroupID.x, 1.0), mat2x4(1.0), mat4(1.0)), mat4x2(1.0), 1.0, uvec4(1u), ivec3(1));
 uint workgroup_base = workgroup_size * _GLF_struct_replacement_14._f2._f2.workgroup_id;
 uint subgroup_base = subgroup_id * subgroup_size;
 uint virtual_gid = workgroup_base + subgroup_base + subgroup_local_id;
 uint next_virtual_gid = workgroup_base + subgroup_base + ((subgroup_local_id + 1) % subgroup_size);
 atomicStore(buf[virtual_gid], uint(1), 3, 64, 4);
 atomicStore(buf[next_virtual_gid], uint(2), 3, 64, 4);
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 2
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT tester EQ_BUFFER expected
