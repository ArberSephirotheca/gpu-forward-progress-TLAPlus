layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(set = 0, binding = 2) buffer WriteVal {
 uint write_val;
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 uint subgroup_id = gl_SubgroupID;
 uint subgroup_size = gl_SubgroupSize;
 uint subgroup_local_id = gl_SubgroupInvocationID;
 _GLF_struct_14 _GLF_struct_replacement_14 = _GLF_struct_14(vec3(1.0), _GLF_struct_9(_GLF_struct_7(true, vec2(1.0), mat3x4(1.0), mat3x4(1.0), mat3(1.0), mat4x3(1.0)), _GLF_struct_8(mat4x3(1.0), ivec4(1), bvec3(true), mat2x3(1.0), mat4(1.0), mat3x2(1.0)), mat2x4(1.0), 1u, gl_NumWorkGroups.x, mat2x4(1.0), bvec3(true)), mat4x2(1.0), _GLF_struct_13(_GLF_struct_10(ivec2(1), mat4x3(1.0), ivec2(1)), mat2x3(1.0), mat4x3(1.0), _GLF_struct_11(bvec2(true), vec2(1.0), bvec2(true), bvec2(true), vec3(1.0), uvec2(1u), 1.0), ivec2(1), _GLF_struct_12(bvec3(true), mat4x3(1.0), ivec2(1), mat3x2(1.0))));
 _GLF_struct_25 _GLF_struct_replacement_25 = _GLF_struct_25(_GLF_struct_19(_GLF_struct_18(mat3(1.0))), _GLF_struct_23(mat4(1.0), _GLF_struct_20(mat4x3(1.0)), _GLF_struct_21(1, vec3(1.0), uvec2(1u), ivec3(1), true), ivec4(1), _GLF_struct_22(mat4x3(1.0), mat4(1.0)), bvec3(true)), true, bvec2(true), _GLF_struct_24(gl_WorkGroupSize.x, mat4(1.0)));
 uint workgroup_id = gl_WorkGroupID.x;
 uint workgroup_base = _GLF_struct_replacement_25._f4.workgroup_size * workgroup_id;
 uint subgroup_base = subgroup_id * subgroup_size;
 _GLF_struct_6 _GLF_struct_replacement_6 = _GLF_struct_6(_GLF_struct_3(mat4(1.0), _GLF_struct_0(mat4x3(1.0), 1.0), _GLF_struct_1(1u), mat2x4(1.0), ivec3(1), _GLF_struct_2(mat4(1.0), vec2(1.0), ivec4(1), mat2x4(1.0)), bvec4(true)), bvec2(true), uvec2(1u), vec2(1.0), workgroup_base + subgroup_base + subgroup_local_id, 1.0, _GLF_struct_5(1u, mat2(1.0), mat2x4(1.0), uvec4(1u), ivec2(1), _GLF_struct_4(mat2x3(1.0), 1u)));
 atomicStore(write_val, uint(_GLF_struct_replacement_6.virtual_gid), 1, 64, 4);
 _GLF_struct_17 _GLF_struct_replacement_17 = _GLF_struct_17(_GLF_struct_16(ivec4(1), mat2x4(1.0), vec4(1.0), _GLF_struct_15(vec3(1.0), ivec4(1), vec3(1.0), mat3(1.0), atomicLoad(write_val, 1, 64, 2), mat3x4(1.0), uvec2(1u))));
 if(_GLF_DEAD(false))
  return;
 buf[_GLF_struct_replacement_6.virtual_gid] = uint(subgroupAllEqual(_GLF_struct_replacement_17._f0._f3.read_val));
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 1
BUFFER write DATA_TYPE uint32 SIZE 1 FILL 0
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 
  BIND BUFFER write AS storage DESCRIPTOR_SET 0 BINDING 2 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT tester EQ_BUFFER expected
