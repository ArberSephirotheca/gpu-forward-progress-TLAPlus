#!amber

DEVICE_FEATURE SubgroupSizeControl.subgroupSizeControl

SET ENGINE_DATA fence_timeout_ms 10000

SHADER compute test GLSL
#version 460
struct _GLF_struct_16 {
 mat2 _f0;
} ;

struct _GLF_struct_14 {
 mat4x3 _f0;
 vec4 _f1;
 mat4 _f2;
} ;

struct _GLF_struct_13 {
 vec3 _f0;
 ivec2 _f1;
 bvec3 _f2;
 mat4x3 _f3;
 bvec2 _f4;
} ;

struct _GLF_struct_15 {
 vec3 _f0;
 _GLF_struct_13 _f1;
 bool _f2;
 bool _f3;
 vec4 _f4;
 _GLF_struct_14 _f5;
 mat3x2 _f6;
} ;

struct _GLF_struct_11 {
 mat4x3 _f0;
 bvec4 _f1;
 bvec4 _f2;
} ;

struct _GLF_struct_12 {
 _GLF_struct_11 _f0;
 mat4x3 _f1;
} ;

struct _GLF_struct_10 {
 bool _f0;
} ;

struct _GLF_struct_9 {
 mat2x4 _f0;
} ;

struct _GLF_struct_17 {
 _GLF_struct_9 _f0;
 ivec4 _f1;
 _GLF_struct_10 _f2;
 _GLF_struct_12 _f3;
 _GLF_struct_15 _f4;
 uint subgroup_base;
 _GLF_struct_16 _f5;
} ;

struct _GLF_struct_6 {
 ivec2 _f0;
 vec2 _f1;
} ;

struct _GLF_struct_5 {
 bvec4 _f0;
} ;

struct _GLF_struct_4 {
 bvec4 _f0;
 mat4 _f1;
 mat3x4 _f2;
 mat2x4 _f3;
 mat2x3 _f4;
} ;

struct _GLF_struct_3 {
 bvec2 _f0;
 ivec4 _f1;
 vec3 _f2;
 mat3x2 _f3;
 mat2x3 _f4;
 mat2 _f5;
 mat4x3 _f6;
} ;

struct _GLF_struct_7 {
 _GLF_struct_3 _f0;
 _GLF_struct_4 _f1;
 _GLF_struct_5 _f2;
 _GLF_struct_6 _f3;
 mat4x3 _f4;
 ivec3 _f5;
} ;

struct _GLF_struct_1 {
 mat3x2 _f0;
 mat4x2 _f1;
 uvec2 _f2;
 mat2 _f3;
 int _f4;
 mat4 _f5;
 ivec3 _f6;
} ;

struct _GLF_struct_0 {
 bvec2 _f0;
 vec4 _f1;
 uvec3 _f2;
 bvec3 _f3;
 bvec2 _f4;
} ;

struct _GLF_struct_2 {
 _GLF_struct_0 _f0;
 _GLF_struct_1 _f1;
 mat4x2 _f2;
} ;

struct _GLF_struct_8 {
 mat4x3 _f0;
 _GLF_struct_2 _f1;
 _GLF_struct_7 _f2;
 vec4 _f3;
 uint subgroup_id;
} ;

layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(set = 0, binding = 2) buffer WriteVal {
 uint write_val;
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 _GLF_struct_8 _GLF_struct_replacement_8 = _GLF_struct_8(mat4x3(1.0), _GLF_struct_2(_GLF_struct_0(bvec2(true), vec4(1.0), uvec3(1u), bvec3(true), bvec2(true)), _GLF_struct_1(mat3x2(1.0), mat4x2(1.0), uvec2(1u), mat2(1.0), 1, mat4(1.0), ivec3(1)), mat4x2(1.0)), _GLF_struct_7(_GLF_struct_3(bvec2(true), ivec4(1), vec3(1.0), mat3x2(1.0), mat2x3(1.0), mat2(1.0), mat4x3(1.0)), _GLF_struct_4(bvec4(true), mat4(1.0), mat3x4(1.0), mat2x4(1.0), mat2x3(1.0)), _GLF_struct_5(bvec4(true)), _GLF_struct_6(ivec2(1), vec2(1.0)), mat4x3(1.0), ivec3(1)), vec4(1.0), gl_SubgroupID);
 uint subgroup_size = gl_SubgroupSize;
 uint subgroup_local_id = gl_SubgroupInvocationID;
 uint num_workgroup = gl_NumWorkGroups.x;
 uint workgroup_size = gl_WorkGroupSize.x;
 uint workgroup_id = gl_WorkGroupID.x;
 uint workgroup_base = workgroup_size * workgroup_id;
 _GLF_struct_17 _GLF_struct_replacement_17 = _GLF_struct_17(_GLF_struct_9(mat2x4(1.0)), ivec4(1), _GLF_struct_10(true), _GLF_struct_12(_GLF_struct_11(mat4x3(1.0), bvec4(true), bvec4(true)), mat4x3(1.0)), _GLF_struct_15(vec3(1.0), _GLF_struct_13(vec3(1.0), ivec2(1), bvec3(true), mat4x3(1.0), bvec2(true)), true, true, vec4(1.0), _GLF_struct_14(mat4x3(1.0), vec4(1.0), mat4(1.0)), mat3x2(1.0)), _GLF_struct_replacement_8.subgroup_id * subgroup_size, _GLF_struct_16(mat2(1.0)));
 uint virtual_gid = workgroup_base + _GLF_struct_replacement_17.subgroup_base + subgroup_local_id;
 atomicStore(write_val, uint(virtual_gid), 1, 64, 4);
 uint read_val = atomicLoad(write_val, 1, 64, 2);
 buf[virtual_gid] = uint(subgroupAllEqual(read_val));
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 1
BUFFER write DATA_TYPE uint32 SIZE 1 FILL 0
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 
  BIND BUFFER write AS storage DESCRIPTOR_SET 0 BINDING 2 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT tester EQ_BUFFER expected
