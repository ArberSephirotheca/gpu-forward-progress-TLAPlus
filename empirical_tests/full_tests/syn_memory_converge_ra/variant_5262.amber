#!amber

DEVICE_FEATURE SubgroupSizeControl.subgroupSizeControl

SET ENGINE_DATA fence_timeout_ms 10000

SHADER compute test GLSL
#version 460

#ifndef REDUCER
#define _GLF_ZERO(X, Y)                   (Y)
#define _GLF_ONE(X, Y)                    (Y)
#define _GLF_FALSE(X, Y)                  (Y)
#define _GLF_TRUE(X, Y)                   (Y)
#define _GLF_IDENTITY(X, Y)               (Y)
#define _GLF_DEAD(X)                      (X)
#define _GLF_FUZZED(X)                    (X)
#define _GLF_WRAPPED_LOOP(X)              X
#define _GLF_WRAPPED_IF_TRUE(X)           X
#define _GLF_WRAPPED_IF_FALSE(X)          X
#define _GLF_SWITCH(X)                    X
#define _GLF_MAKE_IN_BOUNDS_INT(IDX, SZ)  clamp(IDX, 0, SZ - 1)
#define _GLF_MAKE_IN_BOUNDS_UINT(IDX, SZ) clamp(IDX, 0u, SZ - 1u)
#endif


struct _GLF_struct_15 {
 ivec4 _f0;
 ivec4 _f1;
 mat4 _f2;
} ;

struct _GLF_struct_16 {
 _GLF_struct_15 _f0;
} ;

struct _GLF_struct_14 {
 uvec3 _f0;
} ;

struct _GLF_struct_12 {
 mat2x3 _f0;
} ;

struct _GLF_struct_11 {
 mat3x4 _f0;
 mat2x4 _f1;
 mat4x3 _f2;
} ;

struct _GLF_struct_10 {
 mat4x3 _f0;
} ;

struct _GLF_struct_9 {
 bvec3 _f0;
 uvec3 _f1;
 mat3 _f2;
 mat2 _f3;
 mat3x4 _f4;
 mat2x4 _f5;
} ;

struct _GLF_struct_13 {
 _GLF_struct_9 _f0;
 uvec2 _f1;
 _GLF_struct_10 _f2;
 ivec3 _f3;
 _GLF_struct_11 _f4;
 _GLF_struct_12 _f5;
} ;

struct _GLF_struct_7 {
 ivec3 _f0;
 mat4 _f1;
 ivec3 _f2;
 mat3 _f3;
} ;

struct _GLF_struct_6 {
 ivec4 _f0;
 bvec4 _f1;
 mat2 _f2;
 vec3 _f3;
 mat2x3 _f4;
 mat3x4 _f5;
 bvec4 _f6;
} ;

struct _GLF_struct_8 {
 _GLF_struct_6 _f0;
 uvec2 _f1;
 mat3 _f2;
 _GLF_struct_7 _f3;
 bvec3 _f4;
} ;

struct _GLF_struct_5 {
 bool _f0;
} ;

struct _GLF_struct_17 {
 _GLF_struct_5 _f0;
 uint _f1;
 _GLF_struct_8 _f2;
 _GLF_struct_13 _f3;
 _GLF_struct_14 _f4;
 _GLF_struct_16 _f5;
 ivec3 _f6;
 uint workgroup_base;
} ;

struct _GLF_struct_3 {
 uint workgroup_id;
 mat3 _f0;
} ;

struct _GLF_struct_2 {
 uvec3 _f0;
 ivec4 _f1;
} ;

struct _GLF_struct_4 {
 bvec3 _f0;
 bvec4 _f1;
 _GLF_struct_2 _f2;
 bvec3 _f3;
 _GLF_struct_3 _f4;
} ;

struct _GLF_struct_0 {
 uint virtual_gid;
 ivec4 _f0;
 bool _f1;
 uvec4 _f2;
} ;

struct _GLF_struct_1 {
 vec3 _f0;
 mat2 _f1;
 mat4x3 _f2;
 _GLF_struct_0 _f3;
 uvec2 _f4;
} ;

layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(set = 0, binding = 2) buffer WriteVal {
 uint write_val;
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 uint subgroup_id = gl_SubgroupID;
 uint subgroup_size = gl_SubgroupSize;
 uint subgroup_local_id = gl_SubgroupInvocationID;
 uint num_workgroup = gl_NumWorkGroups.x;
 uint workgroup_size = gl_WorkGroupSize.x;
 _GLF_struct_4 _GLF_struct_replacement_4 = _GLF_struct_4(bvec3(true), bvec4(true), _GLF_struct_2(uvec3(1u), ivec4(1)), bvec3(true), _GLF_struct_3(gl_WorkGroupID.x, mat3(1.0)));
 _GLF_struct_17 _GLF_struct_replacement_17 = _GLF_struct_17(_GLF_struct_5(true), 1u, _GLF_struct_8(_GLF_struct_6(ivec4(1), bvec4(true), mat2(1.0), vec3(1.0), mat2x3(1.0), mat3x4(1.0), bvec4(true)), uvec2(1u), mat3(1.0), _GLF_struct_7(ivec3(1), mat4(1.0), ivec3(1), mat3(1.0)), bvec3(true)), _GLF_struct_13(_GLF_struct_9(bvec3(true), uvec3(1u), mat3(1.0), mat2(1.0), mat3x4(1.0), mat2x4(1.0)), uvec2(1u), _GLF_struct_10(mat4x3(1.0)), ivec3(1), _GLF_struct_11(mat3x4(1.0), mat2x4(1.0), mat4x3(1.0)), _GLF_struct_12(mat2x3(1.0))), _GLF_struct_14(uvec3(1u)), _GLF_struct_16(_GLF_struct_15(ivec4(1), ivec4(1), mat4(1.0))), ivec3(1), workgroup_size * _GLF_struct_replacement_4._f4.workgroup_id);
 if(_GLF_DEAD(false))
  barrier();
 if(_GLF_DEAD(_GLF_FALSE(false, (injectionSwitch.x > injectionSwitch.y))))
  barrier();
 uint subgroup_base = subgroup_id * subgroup_size;
 _GLF_struct_1 _GLF_struct_replacement_1 = _GLF_struct_1(vec3(1.0), mat2(1.0), mat4x3(1.0), _GLF_struct_0(_GLF_struct_replacement_17.workgroup_base + subgroup_base + subgroup_local_id, ivec4(1), true, uvec4(1u)), uvec2(1u));
 atomicStore(write_val, uint(_GLF_struct_replacement_1._f3.virtual_gid), 1, 64, 4);
 uint read_val = atomicLoad(write_val, 1, 64, 2);
 buf[_GLF_struct_replacement_1._f3.virtual_gid] = uint(subgroupAllEqual(read_val));
 if(_GLF_DEAD(false))
  barrier();
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 1
BUFFER write DATA_TYPE uint32 SIZE 1 FILL 0
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 
  BIND BUFFER write AS storage DESCRIPTOR_SET 0 BINDING 2 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT tester EQ_BUFFER expected
