#!amber

DEVICE_FEATURE SubgroupSizeControl.subgroupSizeControl

SET ENGINE_DATA fence_timeout_ms 10000

SHADER compute test GLSL
#version 460

#ifndef REDUCER
#define _GLF_ZERO(X, Y)                   (Y)
#define _GLF_ONE(X, Y)                    (Y)
#define _GLF_FALSE(X, Y)                  (Y)
#define _GLF_TRUE(X, Y)                   (Y)
#define _GLF_IDENTITY(X, Y)               (Y)
#define _GLF_DEAD(X)                      (X)
#define _GLF_FUZZED(X)                    (X)
#define _GLF_WRAPPED_LOOP(X)              X
#define _GLF_WRAPPED_IF_TRUE(X)           X
#define _GLF_WRAPPED_IF_FALSE(X)          X
#define _GLF_SWITCH(X)                    X
#define _GLF_MAKE_IN_BOUNDS_INT(IDX, SZ)  clamp(IDX, 0, SZ - 1)
#define _GLF_MAKE_IN_BOUNDS_UINT(IDX, SZ) clamp(IDX, 0u, SZ - 1u)
#endif


struct _GLF_struct_6 {
 uint workgroup_id;
 uvec4 _f0;
} ;

struct _GLF_struct_3 {
 mat3x2 _f0;
 float _f1;
 ivec3 _f2;
 mat3x2 _f3;
} ;

struct _GLF_struct_2 {
 vec3 _f0;
 mat3x4 _f1;
 float _f2;
} ;

struct _GLF_struct_1 {
 mat4 _f0;
 uvec2 _f1;
 uvec2 _f2;
 vec3 _f3;
} ;

struct _GLF_struct_0 {
 bool _f0;
 mat4x2 _f1;
 int _f2;
 bvec4 _f3;
 vec3 _f4;
 vec2 _f5;
} ;

struct _GLF_struct_4 {
 _GLF_struct_0 _f0;
 vec3 _f1;
 _GLF_struct_1 _f2;
 _GLF_struct_2 _f3;
 uint _f4;
 uint subgroup_local_id;
 _GLF_struct_3 _f5;
 uvec2 _f6;
} ;

struct _GLF_struct_5 {
 vec2 _f0;
 _GLF_struct_4 _f1;
} ;

layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(set = 0, binding = 2) buffer WriteVal {
 uint write_val;
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 uvec4 GLF_merged4_0_1_8_1_1_13_2_1_11_3_1_13read_valsubgroup_basesubgroup_idsubgroup_size;
 uint subgroup_id = gl_SubgroupID;
 if(_GLF_DEAD(_GLF_FALSE(false, (injectionSwitch.x > injectionSwitch.y))))
  barrier();
 GLF_merged4_0_1_8_1_1_13_2_1_11_3_1_13read_valsubgroup_basesubgroup_idsubgroup_size.z = subgroup_id;
 uint subgroup_size = gl_SubgroupSize;
 GLF_merged4_0_1_8_1_1_13_2_1_11_3_1_13read_valsubgroup_basesubgroup_idsubgroup_size.w = subgroup_size;
 _GLF_struct_5 _GLF_struct_replacement_5 = _GLF_struct_5(vec2(1.0), _GLF_struct_4(_GLF_struct_0(true, mat4x2(1.0), 1, bvec4(true), vec3(1.0), vec2(1.0)), vec3(1.0), _GLF_struct_1(mat4(1.0), uvec2(1u), uvec2(1u), vec3(1.0)), _GLF_struct_2(vec3(1.0), mat3x4(1.0), 1.0), 1u, gl_SubgroupInvocationID, _GLF_struct_3(mat3x2(1.0), 1.0, ivec3(1), mat3x2(1.0)), uvec2(1u)));
 uint num_workgroup = gl_NumWorkGroups.x;
 uint workgroup_size = gl_WorkGroupSize.x;
 _GLF_struct_6 _GLF_struct_replacement_6 = _GLF_struct_6(gl_WorkGroupID.x, uvec4(1u));
 uint workgroup_base = workgroup_size * _GLF_struct_replacement_6.workgroup_id;
 uint subgroup_base = GLF_merged4_0_1_8_1_1_13_2_1_11_3_1_13read_valsubgroup_basesubgroup_idsubgroup_size.z * GLF_merged4_0_1_8_1_1_13_2_1_11_3_1_13read_valsubgroup_basesubgroup_idsubgroup_size.w;
 if(_GLF_DEAD(_GLF_FALSE(false, (injectionSwitch.x > injectionSwitch.y))))
  barrier();
 GLF_merged4_0_1_8_1_1_13_2_1_11_3_1_13read_valsubgroup_basesubgroup_idsubgroup_size.y = subgroup_base;
 uint virtual_gid = workgroup_base + GLF_merged4_0_1_8_1_1_13_2_1_11_3_1_13read_valsubgroup_basesubgroup_idsubgroup_size.y + _GLF_struct_replacement_5._f1.subgroup_local_id;
 atomicStore(write_val, uint(virtual_gid), 1, 64, 4);
 uint read_val = atomicLoad(write_val, 1, 64, 2);
 GLF_merged4_0_1_8_1_1_13_2_1_11_3_1_13read_valsubgroup_basesubgroup_idsubgroup_size.x = read_val;
 buf[virtual_gid] = uint(subgroupAllEqual(GLF_merged4_0_1_8_1_1_13_2_1_11_3_1_13read_valsubgroup_basesubgroup_idsubgroup_size.x));
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 1
BUFFER write DATA_TYPE uint32 SIZE 1 FILL 0
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 
  BIND BUFFER write AS storage DESCRIPTOR_SET 0 BINDING 2 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT tester EQ_BUFFER expected
