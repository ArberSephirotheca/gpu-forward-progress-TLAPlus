 uint read_val = atomicLoad(write_val, 1, _GLF_IDENTITY(_GLF_IDENTITY(64, clamp(64, _GLF_IDENTITY(64, (64) | 0), _GLF_IDENTITY(64, max(64, 64)))), max(_GLF_IDENTITY(64, clamp(64, _GLF_IDENTITY(64, (64) | 0), _GLF_IDENTITY(64, max(64, _GLF_IDENTITY(64, (64) >> (0 & 31308)))))), _GLF_IDENTITY(64, clamp(64, _GLF_IDENTITY(64, (64) | 0), _GLF_IDENTITY(64, max(64, _GLF_IDENTITY(64, (_GLF_IDENTITY(64, 1 * (64))) ^ 0))))))), 2);
 buf[virtual_gid] = _GLF_IDENTITY(uint(subgroupAllEqual(read_val)), 0u + _GLF_IDENTITY((uint(subgroupAllEqual(read_val))), (_GLF_IDENTITY((uint(subgroupAllEqual(read_val))), (_GLF_IDENTITY((uint(subgroupAllEqual(read_val))), ~ _GLF_IDENTITY((~ ((uint(subgroupAllEqual(read_val))))), 0u ^ ((~ ((uint(subgroupAllEqual(read_val))))))))) * 1u)) + 0u));
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 1
BUFFER write DATA_TYPE uint32 SIZE 1 FILL 0
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 
  BIND BUFFER write AS storage DESCRIPTOR_SET 0 BINDING 2 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT tester EQ_BUFFER expected
