#!amber

DEVICE_FEATURE SubgroupSizeControl.subgroupSizeControl

SET ENGINE_DATA fence_timeout_ms 10000

SHADER compute test GLSL
#version 460
struct _GLF_struct_14 {
 uvec3 _f0;
 mat3x4 _f1;
} ;

struct _GLF_struct_15 {
 uint workgroup_base;
 uvec4 _f0;
 _GLF_struct_14 _f1;
} ;

struct _GLF_struct_13 {
 uint workgroup_size;
 ivec3 _f0;
} ;

struct _GLF_struct_12 {
 uint subgroup_size;
 mat2x3 _f0;
 mat4x3 _f1;
 mat4x3 _f2;
} ;

struct _GLF_struct_9 {
 bvec4 _f0;
 uint read_val;
 bool _f1;
 ivec3 _f2;
 ivec3 _f3;
 mat2 _f4;
} ;

struct _GLF_struct_8 {
 ivec2 _f0;
 uvec4 _f1;
} ;

struct _GLF_struct_7 {
 bvec4 _f0;
 mat2x3 _f1;
} ;

struct _GLF_struct_10 {
 _GLF_struct_7 _f0;
 mat2 _f1;
 _GLF_struct_8 _f2;
 mat3x2 _f3;
 _GLF_struct_9 _f4;
} ;

struct _GLF_struct_5 {
 bool _f0;
 uint _f1;
 mat3x2 _f2;
 vec3 _f3;
} ;

struct _GLF_struct_4 {
 vec4 _f0;
 uvec3 _f1;
 mat4 _f2;
 mat3x4 _f3;
 vec4 _f4;
} ;

struct _GLF_struct_6 {
 uvec2 _f0;
 bvec2 _f1;
 mat4x2 _f2;
 bvec4 _f3;
 float _f4;
 _GLF_struct_4 _f5;
 _GLF_struct_5 _f6;
} ;

struct _GLF_struct_11 {
 _GLF_struct_6 _f0;
 vec4 _f1;
 bvec4 _f2;
 _GLF_struct_10 _f3;
} ;

struct _GLF_struct_1 {
 bvec2 _f0;
} ;

struct _GLF_struct_0 {
 mat2 _f0;
 int _f1;
 uint subgroup_local_id;
 mat4x2 _f2;
 mat2 _f3;
 ivec2 _f4;
 mat2x3 _f5;
 float _f6;
} ;

struct _GLF_struct_2 {
 uvec2 _f0;
 ivec3 _f1;
 _GLF_struct_0 _f2;
 _GLF_struct_1 _f3;
 uvec4 _f4;
 mat3 _f5;
 mat3x2 _f6;
} ;

struct _GLF_struct_3 {
 uint _f0;
 _GLF_struct_2 _f1;
} ;

layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(set = 0, binding = 2) buffer WriteVal {
 uint write_val;
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 uint subgroup_id = gl_SubgroupID;
 _GLF_struct_12 _GLF_struct_replacement_12 = _GLF_struct_12(gl_SubgroupSize, mat2x3(1.0), mat4x3(1.0), mat4x3(1.0));
 _GLF_struct_3 _GLF_struct_replacement_3 = _GLF_struct_3(1u, _GLF_struct_2(uvec2(1u), ivec3(1), _GLF_struct_0(mat2(1.0), 1, gl_SubgroupInvocationID, mat4x2(1.0), mat2(1.0), ivec2(1), mat2x3(1.0), 1.0), _GLF_struct_1(bvec2(true)), uvec4(1u), mat3(1.0), mat3x2(1.0)));
 uint num_workgroup = gl_NumWorkGroups.x;
 _GLF_struct_13 _GLF_struct_replacement_13 = _GLF_struct_13(gl_WorkGroupSize.x, ivec3(1));
 uint workgroup_id = gl_WorkGroupID.x;
 _GLF_struct_15 _GLF_struct_replacement_15 = _GLF_struct_15(_GLF_struct_replacement_13.workgroup_size * workgroup_id, uvec4(1u), _GLF_struct_14(uvec3(1u), mat3x4(1.0)));
 uint subgroup_base = subgroup_id * _GLF_struct_replacement_12.subgroup_size;
 uint virtual_gid = _GLF_struct_replacement_15.workgroup_base + subgroup_base + _GLF_struct_replacement_3._f1._f2.subgroup_local_id;
 atomicStore(write_val, uint(virtual_gid), 1, 64, 4);
 _GLF_struct_11 _GLF_struct_replacement_11 = _GLF_struct_11(_GLF_struct_6(uvec2(1u), bvec2(true), mat4x2(1.0), bvec4(true), 1.0, _GLF_struct_4(vec4(1.0), uvec3(1u), mat4(1.0), mat3x4(1.0), vec4(1.0)), _GLF_struct_5(true, 1u, mat3x2(1.0), vec3(1.0))), vec4(1.0), bvec4(true), _GLF_struct_10(_GLF_struct_7(bvec4(true), mat2x3(1.0)), mat2(1.0), _GLF_struct_8(ivec2(1), uvec4(1u)), mat3x2(1.0), _GLF_struct_9(bvec4(true), atomicLoad(write_val, 1, 64, 2), true, ivec3(1), ivec3(1), mat2(1.0))));
 buf[virtual_gid] = uint(subgroupAllEqual(_GLF_struct_replacement_11._f3._f4.read_val));
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 1
BUFFER write DATA_TYPE uint32 SIZE 1 FILL 0
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 
  BIND BUFFER write AS storage DESCRIPTOR_SET 0 BINDING 2 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT tester EQ_BUFFER expected
