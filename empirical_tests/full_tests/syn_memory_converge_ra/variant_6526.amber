#!amber

DEVICE_FEATURE SubgroupSizeControl.subgroupSizeControl

SET ENGINE_DATA fence_timeout_ms 10000

SHADER compute test GLSL
#version 460
struct _GLF_struct_0 {
 uint read_val;
 bool _f0;
 bvec3 _f1;
} ;

layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(set = 0, binding = 2) buffer WriteVal {
 uint write_val;
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 uvec2 GLF_merged2_0_1_11_1_1_14virtual_gidworkgroup_base;
 uvec4 GLF_merged4_0_1_13_1_1_8_2_1_13_3_1_12num_workgroupread_valsubgroup_sizeworkgroup_id;
 uint subgroup_id = gl_SubgroupID;
 uint subgroup_size = gl_SubgroupSize;
 GLF_merged4_0_1_13_1_1_8_2_1_13_3_1_12num_workgroupread_valsubgroup_sizeworkgroup_id.z = subgroup_size;
 uint subgroup_local_id = gl_SubgroupInvocationID;
 uint num_workgroup = gl_NumWorkGroups.x;
 GLF_merged4_0_1_13_1_1_8_2_1_13_3_1_12num_workgroupread_valsubgroup_sizeworkgroup_id.x = num_workgroup;
 uint workgroup_size = gl_WorkGroupSize.x;
 uint workgroup_id = gl_WorkGroupID.x;
 GLF_merged4_0_1_13_1_1_8_2_1_13_3_1_12num_workgroupread_valsubgroup_sizeworkgroup_id.w = workgroup_id;
 uint workgroup_base = workgroup_size * GLF_merged4_0_1_13_1_1_8_2_1_13_3_1_12num_workgroupread_valsubgroup_sizeworkgroup_id.w;
 GLF_merged2_0_1_11_1_1_14virtual_gidworkgroup_base.y = workgroup_base;
 uint subgroup_base = subgroup_id * GLF_merged4_0_1_13_1_1_8_2_1_13_3_1_12num_workgroupread_valsubgroup_sizeworkgroup_id.z;
 uint virtual_gid = GLF_merged2_0_1_11_1_1_14virtual_gidworkgroup_base.y + subgroup_base + subgroup_local_id;
 GLF_merged2_0_1_11_1_1_14virtual_gidworkgroup_base.x = virtual_gid;
 atomicStore(write_val, uint(GLF_merged2_0_1_11_1_1_14virtual_gidworkgroup_base.x), 1, 64, 4);
 _GLF_struct_0 _GLF_struct_replacement_0 = _GLF_struct_0(atomicLoad(write_val, 1, 64, 2), true, bvec3(true));
 GLF_merged4_0_1_13_1_1_8_2_1_13_3_1_12num_workgroupread_valsubgroup_sizeworkgroup_id.y = _GLF_struct_replacement_0.read_val;
 buf[GLF_merged2_0_1_11_1_1_14virtual_gidworkgroup_base.x] = uint(subgroupAllEqual(GLF_merged4_0_1_13_1_1_8_2_1_13_3_1_12num_workgroupread_valsubgroup_sizeworkgroup_id.y));
