#!amber

DEVICE_FEATURE SubgroupSizeControl.subgroupSizeControl

SET ENGINE_DATA fence_timeout_ms 10000

SHADER compute test GLSL
#version 460
struct _GLF_struct_9 {
 uvec2 _f0;
} ;

struct _GLF_struct_10 {
 _GLF_struct_9 _f0;
} ;

struct _GLF_struct_8 {
 mat2 _f0;
 mat2x3 _f1;
 mat2x4 _f2;
 bvec3 _f3;
} ;

struct _GLF_struct_6 {
 mat2x4 _f0;
 mat2x4 _f1;
 ivec2 _f2;
 vec4 _f3;
 vec3 _f4;
 mat3x4 _f5;
 vec2 _f6;
} ;

struct _GLF_struct_5 {
 mat2 _f0;
 mat4 _f1;
 uvec2 _f2;
 mat4x2 _f3;
 mat4x3 _f4;
} ;

struct _GLF_struct_7 {
 mat2 _f0;
 mat3x4 _f1;
 _GLF_struct_5 _f2;
 _GLF_struct_6 _f3;
} ;

struct _GLF_struct_3 {
 uvec3 _f0;
} ;

struct _GLF_struct_2 {
 bvec3 _f0;
 mat2 _f1;
 bvec2 _f2;
 bvec4 _f3;
} ;

struct _GLF_struct_1 {
 uvec4 _f0;
 mat3x2 _f1;
 uvec3 _f2;
 bool _f3;
 float _f4;
} ;

struct _GLF_struct_0 {
 vec4 _f0;
} ;

struct _GLF_struct_4 {
 _GLF_struct_0 _f0;
 _GLF_struct_1 _f1;
 _GLF_struct_2 _f2;
 _GLF_struct_3 _f3;
} ;

struct _GLF_struct_11 {
 bool _f0;
 float _f1;
 _GLF_struct_4 _f2;
 _GLF_struct_7 _f3;
 _GLF_struct_8 _f4;
 _GLF_struct_10 _f5;
 uint subgroup_id;
 uint _f6;
} ;

layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(set = 0, binding = 2) buffer WriteVal {
 uint write_val;
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 uvec3 GLF_merged3_0_1_8_1_1_13_2_1_12read_valsubgroup_baseworkgroup_id;
 _GLF_struct_11 _GLF_struct_replacement_11 = _GLF_struct_11(true, 1.0, _GLF_struct_4(_GLF_struct_0(vec4(1.0)), _GLF_struct_1(uvec4(1u), mat3x2(1.0), uvec3(1u), true, 1.0), _GLF_struct_2(bvec3(true), mat2(1.0), bvec2(true), bvec4(true)), _GLF_struct_3(uvec3(1u))), _GLF_struct_7(mat2(1.0), mat3x4(1.0), _GLF_struct_5(mat2(1.0), mat4(1.0), uvec2(1u), mat4x2(1.0), mat4x3(1.0)), _GLF_struct_6(mat2x4(1.0), mat2x4(1.0), ivec2(1), vec4(1.0), vec3(1.0), mat3x4(1.0), vec2(1.0))), _GLF_struct_8(mat2(1.0), mat2x3(1.0), mat2x4(1.0), bvec3(true)), _GLF_struct_10(_GLF_struct_9(uvec2(1u))), gl_SubgroupID, 1u);
 uint subgroup_size = gl_SubgroupSize;
 uint subgroup_local_id = gl_SubgroupInvocationID;
 uint num_workgroup = gl_NumWorkGroups.x;
 uint workgroup_size = gl_WorkGroupSize.x;
 uint workgroup_id = gl_WorkGroupID.x;
 GLF_merged3_0_1_8_1_1_13_2_1_12read_valsubgroup_baseworkgroup_id.z = workgroup_id;
 uint workgroup_base = workgroup_size * GLF_merged3_0_1_8_1_1_13_2_1_12read_valsubgroup_baseworkgroup_id.z;
 uint subgroup_base = _GLF_struct_replacement_11.subgroup_id * subgroup_size;
 GLF_merged3_0_1_8_1_1_13_2_1_12read_valsubgroup_baseworkgroup_id.y = subgroup_base;
 uint virtual_gid = workgroup_base + GLF_merged3_0_1_8_1_1_13_2_1_12read_valsubgroup_baseworkgroup_id.y + subgroup_local_id;
 atomicStore(write_val, uint(virtual_gid), 1, 64, 4);
 uint read_val = atomicLoad(write_val, 1, 64, 2);
 GLF_merged3_0_1_8_1_1_13_2_1_12read_valsubgroup_baseworkgroup_id.x = read_val;
 buf[virtual_gid] = uint(subgroupAllEqual(GLF_merged3_0_1_8_1_1_13_2_1_12read_valsubgroup_baseworkgroup_id.x));
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 1
BUFFER write DATA_TYPE uint32 SIZE 1 FILL 0
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 
  BIND BUFFER write AS storage DESCRIPTOR_SET 0 BINDING 2 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT tester EQ_BUFFER expected
