#!amber

DEVICE_FEATURE SubgroupSizeControl.subgroupSizeControl

SET ENGINE_DATA fence_timeout_ms 10000

SHADER compute test GLSL
#version 460

#ifndef REDUCER
#define _GLF_ZERO(X, Y)                   (Y)
#define _GLF_ONE(X, Y)                    (Y)
#define _GLF_FALSE(X, Y)                  (Y)
#define _GLF_TRUE(X, Y)                   (Y)
#define _GLF_IDENTITY(X, Y)               (Y)
#define _GLF_DEAD(X)                      (X)
#define _GLF_FUZZED(X)                    (X)
#define _GLF_WRAPPED_LOOP(X)              X
#define _GLF_WRAPPED_IF_TRUE(X)           X
#define _GLF_WRAPPED_IF_FALSE(X)          X
#define _GLF_SWITCH(X)                    X
#define _GLF_MAKE_IN_BOUNDS_INT(IDX, SZ)  clamp(IDX, 0, SZ - 1)
#define _GLF_MAKE_IN_BOUNDS_UINT(IDX, SZ) clamp(IDX, 0u, SZ - 1u)
#endif


struct _GLF_struct_11 {
 ivec2 _f0;
 mat2x4 _f1;
 mat4x2 _f2;
 mat4x2 _f3;
} ;

struct _GLF_struct_10 {
 uvec4 _f0;
 mat2x3 _f1;
 mat2x3 _f2;
 uvec2 _f3;
 vec4 _f4;
} ;

struct _GLF_struct_12 {
 ivec4 _f0;
 _GLF_struct_10 _f1;
 vec3 _f2;
 _GLF_struct_11 _f3;
} ;

struct _GLF_struct_8 {
 uint _f0;
 mat4x2 _f1;
} ;

struct _GLF_struct_9 {
 uvec4 _f0;
 _GLF_struct_8 _f1;
} ;

struct _GLF_struct_7 {
 mat2 _f0;
} ;

struct _GLF_struct_13 {
 _GLF_struct_7 _f0;
 _GLF_struct_9 _f1;
 uint num_workgroup;
 _GLF_struct_12 _f2;
 mat4 _f3;
} ;

struct _GLF_struct_4 {
 ivec2 _f0;
 mat3x2 _f1;
 bool _f2;
 ivec4 _f3;
} ;

struct _GLF_struct_3 {
 bvec3 _f0;
 mat3x4 _f1;
 bvec4 _f2;
 ivec3 _f3;
 uvec3 _f4;
 float _f5;
} ;

struct _GLF_struct_5 {
 mat4x2 _f0;
 _GLF_struct_3 _f1;
 _GLF_struct_4 _f2;
 vec4 _f3;
} ;

struct _GLF_struct_1 {
 int _f0;
} ;

struct _GLF_struct_0 {
 mat3 _f0;
 uvec3 _f1;
 vec4 _f2;
 mat2x4 _f3;
 uvec2 _f4;
 bvec3 _f5;
} ;

struct _GLF_struct_2 {
 _GLF_struct_0 _f0;
 _GLF_struct_1 _f1;
} ;

struct _GLF_struct_6 {
 mat4x2 _f0;
 _GLF_struct_2 _f1;
 _GLF_struct_5 _f2;
 uint workgroup_size;
} ;

layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(set = 0, binding = 2) buffer WriteVal {
 uint write_val;
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 uint subgroup_id = gl_SubgroupID;
 if(_GLF_DEAD(false))
  return;
 uint subgroup_size = gl_SubgroupSize;
 if(_GLF_DEAD(_GLF_FALSE(false, (injectionSwitch.x > injectionSwitch.y))))
  return;
 uint subgroup_local_id = gl_SubgroupInvocationID;
 _GLF_struct_13 _GLF_struct_replacement_13 = _GLF_struct_13(_GLF_struct_7(mat2(1.0)), _GLF_struct_9(uvec4(1u), _GLF_struct_8(1u, mat4x2(1.0))), gl_NumWorkGroups.x, _GLF_struct_12(ivec4(1), _GLF_struct_10(uvec4(1u), mat2x3(1.0), mat2x3(1.0), uvec2(1u), vec4(1.0)), vec3(1.0), _GLF_struct_11(ivec2(1), mat2x4(1.0), mat4x2(1.0), mat4x2(1.0))), mat4(1.0));
 _GLF_struct_6 _GLF_struct_replacement_6 = _GLF_struct_6(mat4x2(1.0), _GLF_struct_2(_GLF_struct_0(mat3(1.0), uvec3(1u), vec4(1.0), mat2x4(1.0), uvec2(1u), bvec3(true)), _GLF_struct_1(1)), _GLF_struct_5(mat4x2(1.0), _GLF_struct_3(bvec3(true), mat3x4(1.0), bvec4(true), ivec3(1), uvec3(1u), 1.0), _GLF_struct_4(ivec2(1), mat3x2(1.0), true, ivec4(1)), vec4(1.0)), gl_WorkGroupSize.x);
 uint workgroup_id = gl_WorkGroupID.x;
 uint workgroup_base = _GLF_struct_replacement_6.workgroup_size * workgroup_id;
 uint subgroup_base = subgroup_id * subgroup_size;
 if(_GLF_DEAD(false))
  {
   if(_GLF_WRAPPED_IF_TRUE(_GLF_IDENTITY(true, _GLF_TRUE(true, (injectionSwitch.x < injectionSwitch.y)) && (_GLF_IDENTITY(true, (true) && true)))))
    {
     return;
    }
   else
    {
    }
  }
 if(_GLF_DEAD(_GLF_FALSE(false, (injectionSwitch.x > injectionSwitch.y))))
  return;
 uint virtual_gid = workgroup_base + subgroup_base + subgroup_local_id;
 atomicStore(write_val, uint(virtual_gid), 1, 64, 4);
 uint read_val = atomicLoad(write_val, 1, 64, 2);
 buf[virtual_gid] = uint(subgroupAllEqual(read_val));
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 1
BUFFER write DATA_TYPE uint32 SIZE 1 FILL 0
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 
  BIND BUFFER write AS storage DESCRIPTOR_SET 0 BINDING 2 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT tester EQ_BUFFER expected
