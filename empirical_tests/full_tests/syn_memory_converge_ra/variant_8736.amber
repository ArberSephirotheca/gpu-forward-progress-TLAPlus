} ;

struct _GLF_struct_3 {
 bool _f0;
 vec4 _f1;
 _GLF_struct_0 _f2;
 _GLF_struct_1 _f3;
 _GLF_struct_2 _f4;
 mat4 _f5;
} ;

struct _GLF_struct_11 {
 vec4 _f0;
 uvec3 _f1;
 uint num_workgroup;
 _GLF_struct_3 _f2;
 _GLF_struct_10 _f3;
} ;

layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(set = 0, binding = 2) buffer WriteVal {
 uint write_val;
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 uvec2 GLF_merged2_0_1_17_1_1_13subgroup_local_idsubgroup_size;
 uvec2 GLF_merged2_0_1_13_1_1_11subgroup_basevirtual_gid;
 uvec2 GLF_merged2_0_1_13_1_1_11num_workgroupsubgroup_id;
 uint subgroup_id = gl_SubgroupID;
 GLF_merged2_0_1_13_1_1_11num_workgroupsubgroup_id.y = subgroup_id;
 uint subgroup_size = gl_SubgroupSize;
 GLF_merged2_0_1_17_1_1_13subgroup_local_idsubgroup_size.y = subgroup_size;
 uint subgroup_local_id = gl_SubgroupInvocationID;
 GLF_merged2_0_1_17_1_1_13subgroup_local_idsubgroup_size.x = subgroup_local_id;
 _GLF_struct_11 _GLF_struct_replacement_11 = _GLF_struct_11(vec4(1.0), uvec3(1u), gl_NumWorkGroups.x, _GLF_struct_3(true, vec4(1.0), _GLF_struct_0(bvec3(true), bvec4(true), mat4(1.0), uvec4(1u), mat3x2(1.0), mat3(1.0), bvec3(true)), _GLF_struct_1(mat4x2(1.0), uvec3(1u), 1), _GLF_struct_2(mat2x4(1.0), 1, 1), mat4(1.0)), _GLF_struct_10(_GLF_struct_4(mat3x2(1.0)), _GLF_struct_5(ivec2(1), 1.0, uvec4(1u)), _GLF_struct_6(ivec3(1)), _GLF_struct_7(vec4(1.0), mat2x4(1.0), vec4(1.0), 1.0, vec4(1.0)), mat3x2(1.0), _GLF_struct_8(1u, vec3(1.0), 1, mat2(1.0), true, mat4x3(1.0), 1), _GLF_struct_9(uvec4(1u), mat3x2(1.0), mat2(1.0), vec4(1.0), vec2(1.0), bvec3(true), ivec2(1))));
 GLF_merged2_0_1_13_1_1_11num_workgroupsubgroup_id.x = _GLF_struct_replacement_11.num_workgroup;
 uint workgroup_size = gl_WorkGroupSize.x;
 uint workgroup_id = gl_WorkGroupID.x;
 uint workgroup_base = workgroup_size * workgroup_id;
 uint subgroup_base = GLF_merged2_0_1_13_1_1_11num_workgroupsubgroup_id.y * GLF_merged2_0_1_17_1_1_13subgroup_local_idsubgroup_size.y;
 GLF_merged2_0_1_13_1_1_11subgroup_basevirtual_gid.x = subgroup_base;
 uint virtual_gid = workgroup_base + GLF_merged2_0_1_13_1_1_11subgroup_basevirtual_gid.x + GLF_merged2_0_1_17_1_1_13subgroup_local_idsubgroup_size.x;
 GLF_merged2_0_1_13_1_1_11subgroup_basevirtual_gid.y = virtual_gid;
 atomicStore(write_val, uint(GLF_merged2_0_1_13_1_1_11subgroup_basevirtual_gid.y), 1, 64, 4);
 uint read_val = atomicLoad(write_val, 1, 64, 2);
 buf[GLF_merged2_0_1_13_1_1_11subgroup_basevirtual_gid.y] = uint(subgroupAllEqual(read_val));
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 1
BUFFER write DATA_TYPE uint32 SIZE 1 FILL 0
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 
  BIND BUFFER write AS storage DESCRIPTOR_SET 0 BINDING 2 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT tester EQ_BUFFER expected
