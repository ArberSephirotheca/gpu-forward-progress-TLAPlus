 bvec2 _f1;
 vec2 _f2;
 vec4 _f3;
} ;

struct _GLF_struct_11 {
 bvec4 _f0;
 mat4x3 _f1;
 mat3x2 _f2;
 mat3x4 _f3;
 mat2x4 _f4;
 bvec2 _f5;
 ivec4 _f6;
} ;

struct _GLF_struct_15 {
 _GLF_struct_11 _f0;
 _GLF_struct_12 _f1;
 _GLF_struct_13 _f2;
 uint workgroup_base;
 _GLF_struct_14 _f3;
 vec2 _f4;
} ;

struct _GLF_struct_16 {
 _GLF_struct_15 _f0;
} ;

struct _GLF_struct_8 {
