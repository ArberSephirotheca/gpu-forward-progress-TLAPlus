layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(set = 0, binding = 2) buffer Checker {
 uint checker[];
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 uint subgroup_id = gl_SubgroupID;
 _GLF_struct_26 _GLF_struct_replacement_26 = _GLF_struct_26(_GLF_struct_17(_GLF_struct_15(1u, bvec3(true), mat2x3(1.0)), _GLF_struct_16(mat2(1.0), uvec3(1u), mat3(1.0))), mat4(1.0), _GLF_struct_20(1.0, 1, _GLF_struct_18(1.0, 1, vec2(1.0), vec4(1.0), 1.0, ivec3(1), 1u), _GLF_struct_19(mat3x2(1.0), true, vec4(1.0)), bvec3(true)), _GLF_struct_22(uvec2(1u), _GLF_struct_21(bvec2(true), ivec3(1), uvec3(1u), bvec4(true), mat2x3(1.0))), _GLF_struct_25(gl_SubgroupSize, _GLF_struct_23(vec4(1.0), 1, ivec4(1), mat3x4(1.0), uvec3(1u), ivec2(1), bvec3(true)), mat3(1.0), _GLF_struct_24(uvec3(1u), 1.0, mat4x2(1.0), uvec2(1u), mat4x3(1.0), mat3x4(1.0))));
 uint subgroup_local_id = gl_SubgroupInvocationID;
 uint num_workgroup = gl_NumWorkGroups.x;
 _GLF_struct_34 _GLF_struct_replacement_34 = _GLF_struct_34(mat4(1.0), gl_WorkGroupSize.x, uvec4(1u));
 uint workgroup_id = gl_WorkGroupID.x;
 _GLF_struct_14 _GLF_struct_replacement_14 = _GLF_struct_14(_GLF_struct_3(_GLF_struct_0(mat4x2(1.0), uvec2(1u), mat4x2(1.0)), _GLF_struct_1(uvec4(1u), ivec4(1), vec4(1.0), mat2x3(1.0)), bvec2(true), mat4(1.0), _GLF_struct_2(mat2x3(1.0), mat3x4(1.0), true, bvec4(true)), mat4x2(1.0)), _GLF_struct_5(_GLF_struct_4(mat3(1.0), mat3x2(1.0))), _GLF_struct_9(_GLF_struct_6(mat2(1.0), uvec4(1u), 1u), _GLF_struct_7(mat4x3(1.0), 1.0, mat4x3(1.0)), _GLF_struct_replacement_34.workgroup_size * workgroup_id, ivec3(1), _GLF_struct_8(ivec3(1))), _GLF_struct_13(mat4x3(1.0), _GLF_struct_10(1.0, vec4(1.0), mat3x2(1.0), ivec4(1), 1.0, bvec2(true), mat2(1.0)), mat3x2(1.0), _GLF_struct_11(true, uvec2(1u), mat2x4(1.0), vec3(1.0)), mat4(1.0), _GLF_struct_12(mat2x3(1.0), vec3(1.0), mat3x4(1.0), true, mat4x3(1.0), mat3x4(1.0)), 1u));
 _GLF_struct_33 _GLF_struct_replacement_33 = _GLF_struct_33(vec4(1.0), _GLF_struct_30(subgroup_id * _GLF_struct_replacement_26._f4.subgroup_size, mat3x2(1.0), _GLF_struct_27(1, uvec3(1u), mat4x3(1.0), 1.0), _GLF_struct_28(bvec2(true), bvec3(true), vec3(1.0)), _GLF_struct_29(mat2x3(1.0), 1.0, ivec2(1), vec3(1.0), bvec2(true), uvec4(1u), vec4(1.0))), uvec2(1u), _GLF_struct_32(vec4(1.0), _GLF_struct_31(mat2(1.0), 1u), bvec2(true)), mat3x2(1.0), mat4(1.0), bvec4(true));
 uint virtual_gid = _GLF_struct_replacement_14._f2.workgroup_base + _GLF_struct_replacement_33._f1.subgroup_base + subgroup_local_id;
 uint next_virtual_gid = _GLF_struct_replacement_14._f2.workgroup_base + _GLF_struct_replacement_33._f1.subgroup_base + ((subgroup_local_id + 1) % _GLF_struct_replacement_26._f4.subgroup_size);
 uint read = atomicLoad(buf[virtual_gid], 3, 64, 2);
 if((subgroup_local_id % 2) == 0)
  {
   subgroupAll(false);
   atomicStore(buf[next_virtual_gid], uint(1), 3, 64, 4);
  }
 else
  {
   subgroupAll(false);
   atomicStore(buf[next_virtual_gid], uint(1), 3, 64, 4);
  }
 subgroupBarrier();
 atomicStore(checker[virtual_gid], read, 3, 64, 4);
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 2
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END
BUFFER checker DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected_checker DATA_TYPE uint32 SIZE 8388096 FILL 0

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 
  BIND BUFFER checker AS storage DESCRIPTOR_SET 0 BINDING 2 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT checker EQ_BUFFER expected_checker
