 while(_GLF_WRAPPED_LOOP(_GLF_FALSE(false, (_GLF_IDENTITY(injectionSwitch.x, (false ? _GLF_FUZZED(-8638.0813) : injectionSwitch.x)) > injectionSwitch.y))));
