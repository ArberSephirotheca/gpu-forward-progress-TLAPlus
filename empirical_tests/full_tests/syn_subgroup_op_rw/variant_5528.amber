#!amber

DEVICE_FEATURE SubgroupSizeControl.subgroupSizeControl

SET ENGINE_DATA fence_timeout_ms 10000

SHADER compute test GLSL
#version 460

#ifndef REDUCER
#define _GLF_ZERO(X, Y)                   (Y)
#define _GLF_ONE(X, Y)                    (Y)
#define _GLF_FALSE(X, Y)                  (Y)
#define _GLF_TRUE(X, Y)                   (Y)
#define _GLF_IDENTITY(X, Y)               (Y)
#define _GLF_DEAD(X)                      (X)
#define _GLF_FUZZED(X)                    (X)
#define _GLF_WRAPPED_LOOP(X)              X
#define _GLF_WRAPPED_IF_TRUE(X)           X
#define _GLF_WRAPPED_IF_FALSE(X)          X
#define _GLF_SWITCH(X)                    X
#define _GLF_MAKE_IN_BOUNDS_INT(IDX, SZ)  clamp(IDX, 0, SZ - 1)
#define _GLF_MAKE_IN_BOUNDS_UINT(IDX, SZ) clamp(IDX, 0u, SZ - 1u)
#endif


struct _GLF_struct_21 {
 bvec3 _f0;
 mat2x4 _f1;
 vec3 _f2;
} ;

struct _GLF_struct_20 {
 uint _f0;
 float _f1;
} ;

struct _GLF_struct_19 {
 mat3x4 _f0;
} ;

struct _GLF_struct_18 {
 vec3 _f0;
 vec2 _f1;
} ;

struct _GLF_struct_17 {
 vec2 _f0;
 uint _f1;
} ;

struct _GLF_struct_16 {
 ivec2 _f0;
 bool _f1;
 mat2x3 _f2;
 mat4x3 _f3;
 uvec2 _f4;
 mat2x4 _f5;
} ;

struct _GLF_struct_22 {
 _GLF_struct_16 _f0;
 _GLF_struct_17 _f1;
 _GLF_struct_18 _f2;
 _GLF_struct_19 _f3;
 _GLF_struct_20 _f4;
 _GLF_struct_21 _f5;
} ;

struct _GLF_struct_15 {
 vec3 _f0;
 uint read;
} ;

struct _GLF_struct_23 {
 uvec4 _f0;
 _GLF_struct_15 _f1;
 _GLF_struct_22 _f2;
} ;

struct _GLF_struct_12 {
 vec2 _f0;
 mat4x3 _f1;
 ivec4 _f2;
 mat4x3 _f3;
} ;

struct _GLF_struct_11 {
 uint subgroup_base;
 ivec4 _f0;
 uvec2 _f1;
 uvec2 _f2;
 mat3x2 _f3;
} ;

struct _GLF_struct_10 {
 mat3 _f0;
 mat4x3 _f1;
 ivec3 _f2;
 float _f3;
} ;

struct _GLF_struct_9 {
 uvec4 _f0;
 uvec3 _f1;
 ivec3 _f2;
 mat2x4 _f3;
 mat3x4 _f4;
 bvec3 _f5;
} ;

struct _GLF_struct_13 {
 _GLF_struct_9 _f0;
 _GLF_struct_10 _f1;
 _GLF_struct_11 _f2;
 _GLF_struct_12 _f3;
} ;

struct _GLF_struct_7 {
 uint _f0;
 vec2 _f1;
 bool _f2;
 mat4 _f3;
} ;

struct _GLF_struct_6 {
 ivec2 _f0;
 mat4x2 _f1;
 mat2 _f2;
 bvec4 _f3;
 bvec4 _f4;
 ivec4 _f5;
 uvec3 _f6;
} ;

struct _GLF_struct_8 {
 _GLF_struct_6 _f0;
 _GLF_struct_7 _f1;
 uvec2 _f2;
} ;

struct _GLF_struct_14 {
 mat2x4 _f0;
 _GLF_struct_8 _f1;
 _GLF_struct_13 _f2;
 vec4 _f3;
} ;

struct _GLF_struct_3 {
 uvec2 _f0;
 vec3 _f1;
 mat2x3 _f2;
 bvec3 _f3;
 mat3 _f4;
 vec2 _f5;
 bvec4 _f6;
} ;

struct _GLF_struct_2 {
 uvec3 _f0;
 float _f1;
 bvec3 _f2;
 mat2 _f3;
 mat2x4 _f4;
 mat3x2 _f5;
} ;

struct _GLF_struct_4 {
 mat3 _f0;
 uint virtual_gid;
 _GLF_struct_2 _f1;
 _GLF_struct_3 _f2;
} ;

struct _GLF_struct_0 {
 bvec2 _f0;
 vec2 _f1;
} ;

struct _GLF_struct_1 {
 _GLF_struct_0 _f0;
 int _f1;
 bvec3 _f2;
} ;

struct _GLF_struct_5 {
 _GLF_struct_1 _f0;
 _GLF_struct_4 _f1;
 mat4 _f2;
} ;

layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(set = 0, binding = 2) buffer Checker {
 uint checker[];
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 if(_GLF_DEAD(false))
  return;
 uint subgroup_id = gl_SubgroupID;
 if(_GLF_DEAD(false))
  return;
 uint subgroup_size = gl_SubgroupSize;
 uint subgroup_local_id = gl_SubgroupInvocationID;
 uint num_workgroup = gl_NumWorkGroups.x;
 uint workgroup_size = gl_WorkGroupSize.x;
 uint workgroup_id = gl_WorkGroupID.x;
 uint workgroup_base = workgroup_size * workgroup_id;
 _GLF_struct_14 _GLF_struct_replacement_14 = _GLF_struct_14(mat2x4(1.0), _GLF_struct_8(_GLF_struct_6(ivec2(1), mat4x2(1.0), mat2(1.0), bvec4(true), bvec4(true), ivec4(1), uvec3(1u)), _GLF_struct_7(1u, vec2(1.0), true, mat4(1.0)), uvec2(1u)), _GLF_struct_13(_GLF_struct_9(uvec4(1u), uvec3(1u), ivec3(1), mat2x4(1.0), mat3x4(1.0), bvec3(true)), _GLF_struct_10(mat3(1.0), mat4x3(1.0), ivec3(1), 1.0), _GLF_struct_11(subgroup_id * subgroup_size, ivec4(1), uvec2(1u), uvec2(1u), mat3x2(1.0)), _GLF_struct_12(vec2(1.0), mat4x3(1.0), ivec4(1), mat4x3(1.0))), vec4(1.0));
 _GLF_struct_5 _GLF_struct_replacement_5 = _GLF_struct_5(_GLF_struct_1(_GLF_struct_0(bvec2(true), vec2(1.0)), 1, bvec3(true)), _GLF_struct_4(mat3(1.0), workgroup_base + _GLF_struct_replacement_14._f2._f2.subgroup_base + subgroup_local_id, _GLF_struct_2(uvec3(1u), 1.0, bvec3(true), mat2(1.0), mat2x4(1.0), mat3x2(1.0)), _GLF_struct_3(uvec2(1u), vec3(1.0), mat2x3(1.0), bvec3(true), mat3(1.0), vec2(1.0), bvec4(true))), mat4(1.0));
 uint next_virtual_gid = workgroup_base + _GLF_struct_replacement_14._f2._f2.subgroup_base + ((subgroup_local_id + 1) % subgroup_size);
 _GLF_struct_23 _GLF_struct_replacement_23 = _GLF_struct_23(uvec4(1u), _GLF_struct_15(vec3(1.0), atomicLoad(buf[_GLF_struct_replacement_5._f1.virtual_gid], 3, 64, 2)), _GLF_struct_22(_GLF_struct_16(ivec2(1), true, mat2x3(1.0), mat4x3(1.0), uvec2(1u), mat2x4(1.0)), _GLF_struct_17(vec2(1.0), 1u), _GLF_struct_18(vec3(1.0), vec2(1.0)), _GLF_struct_19(mat3x4(1.0)), _GLF_struct_20(1u, 1.0), _GLF_struct_21(bvec3(true), mat2x4(1.0), vec3(1.0))));
 if(_GLF_DEAD(false))
  return;
 if(_GLF_DEAD(false))
  return;
 if(_GLF_DEAD(_GLF_FALSE(false, (injectionSwitch.x > injectionSwitch.y))))
  return;
 if((subgroup_local_id % 2) == 0)
  {
   if(_GLF_DEAD(_GLF_IDENTITY(false, ! (! (false)))))
    {
     if(_GLF_DEAD(_GLF_IDENTITY(false, bool(bvec3(false, false, true)))))
      return;
     barrier();
    }
   subgroupAll(false);
   if(_GLF_DEAD(false))
    return;
   atomicStore(buf[next_virtual_gid], uint(1), 3, 64, 4);
  }
 else
  {
   subgroupAll(false);
   atomicStore(buf[next_virtual_gid], uint(1), 3, 64, 4);
  }
 subgroupBarrier();
 atomicStore(checker[_GLF_struct_replacement_5._f1.virtual_gid], _GLF_struct_replacement_23._f1.read, 3, 64, 4);
 if(_GLF_DEAD(false))
  return;
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 2
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END
BUFFER checker DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected_checker DATA_TYPE uint32 SIZE 8388096 FILL 0

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 
  BIND BUFFER checker AS storage DESCRIPTOR_SET 0 BINDING 2 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT checker EQ_BUFFER expected_checker
