 atomicStore(checker[virtual_gid], _GLF_IDENTITY(read, (read) | (read)), _GLF_IDENTITY(3, (_GLF_IDENTITY(3, clamp(3, 3, _GLF_IDENTITY(3, ~ (_GLF_IDENTITY(~ (3), 0 | (~ (3)))))))) << 0), 64, 4);
