          continue;
         break;
        }
       if(_GLF_DEAD(_GLF_IDENTITY(false, _GLF_IDENTITY(! (! (_GLF_IDENTITY(false, (false) || false))), bool(bool(! (! (_GLF_IDENTITY(false, (false) || false)))))))))
        break;
       do
        {
         if(_GLF_DEAD(false))
