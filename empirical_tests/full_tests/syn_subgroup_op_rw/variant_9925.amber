#!amber

DEVICE_FEATURE SubgroupSizeControl.subgroupSizeControl

SET ENGINE_DATA fence_timeout_ms 10000

SHADER compute test GLSL
#version 460

#ifndef REDUCER
#define _GLF_ZERO(X, Y)                   (Y)
#define _GLF_ONE(X, Y)                    (Y)
#define _GLF_FALSE(X, Y)                  (Y)
#define _GLF_TRUE(X, Y)                   (Y)
#define _GLF_IDENTITY(X, Y)               (Y)
#define _GLF_DEAD(X)                      (X)
#define _GLF_FUZZED(X)                    (X)
#define _GLF_WRAPPED_LOOP(X)              X
#define _GLF_WRAPPED_IF_TRUE(X)           X
#define _GLF_WRAPPED_IF_FALSE(X)          X
#define _GLF_SWITCH(X)                    X
#define _GLF_MAKE_IN_BOUNDS_INT(IDX, SZ)  clamp(IDX, 0, SZ - 1)
#define _GLF_MAKE_IN_BOUNDS_UINT(IDX, SZ) clamp(IDX, 0u, SZ - 1u)
#endif


layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(set = 0, binding = 2) buffer Checker {
 uint checker[];
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 uvec3 GLF_merged3_0_1_17_1_1_11_2_1_14subgroup_local_idvirtual_gidworkgroup_base;
 uvec4 GLF_merged2_0_3_62_3_1_13GLF_merged3_0_1_4_1_1_13_2_1_14readsubgroup_sizeworkgroup_basesubgroup_base;
 uvec2 GLF_merged2_0_1_11_1_1_17subgroup_idsubgroup_local_id;
 uvec3 GLF_merged3_0_1_4_1_1_13_2_1_14readsubgroup_sizeworkgroup_base;
 GLF_merged2_0_3_62_3_1_13GLF_merged3_0_1_4_1_1_13_2_1_14readsubgroup_sizeworkgroup_basesubgroup_base.xyz = GLF_merged3_0_1_4_1_1_13_2_1_14readsubgroup_sizeworkgroup_base;
 uint subgroup_id = gl_SubgroupID;
 GLF_merged2_0_1_11_1_1_17subgroup_idsubgroup_local_id.x = subgroup_id;
 uint subgroup_size = gl_SubgroupSize;
 GLF_merged2_0_3_62_3_1_13GLF_merged3_0_1_4_1_1_13_2_1_14readsubgroup_sizeworkgroup_basesubgroup_base.xyz.y = subgroup_size;
 uint subgroup_local_id = gl_SubgroupInvocationID;
 GLF_merged3_0_1_17_1_1_11_2_1_14subgroup_local_idvirtual_gidworkgroup_base.x = subgroup_local_id;
 GLF_merged2_0_1_11_1_1_17subgroup_idsubgroup_local_id.y = GLF_merged3_0_1_17_1_1_11_2_1_14subgroup_local_idvirtual_gidworkgroup_base.x;
 uint num_workgroup = gl_NumWorkGroups.x;
 do
  {
   if(_GLF_DEAD(false))
    continue;
   if(_GLF_DEAD(_GLF_FALSE(false, (injectionSwitch.x > injectionSwitch.y))))
    return;
  }
 while(_GLF_WRAPPED_LOOP(false));
 uint workgroup_size = gl_WorkGroupSize.x;
 if(_GLF_DEAD(_GLF_IDENTITY(false, ! (! (false)))))
  return;
 uint workgroup_id = gl_WorkGroupID.x;
 uint workgroup_base = workgroup_size * workgroup_id;
 GLF_merged3_0_1_17_1_1_11_2_1_14subgroup_local_idvirtual_gidworkgroup_base.z = workgroup_base;
 GLF_merged2_0_3_62_3_1_13GLF_merged3_0_1_4_1_1_13_2_1_14readsubgroup_sizeworkgroup_basesubgroup_base.xyz.z = GLF_merged3_0_1_17_1_1_11_2_1_14subgroup_local_idvirtual_gidworkgroup_base.z;
 uint subgroup_base = GLF_merged2_0_1_11_1_1_17subgroup_idsubgroup_local_id.x * GLF_merged2_0_3_62_3_1_13GLF_merged3_0_1_4_1_1_13_2_1_14readsubgroup_sizeworkgroup_basesubgroup_base.xyz.y;
 GLF_merged2_0_3_62_3_1_13GLF_merged3_0_1_4_1_1_13_2_1_14readsubgroup_sizeworkgroup_basesubgroup_base.w = subgroup_base;
 if(_GLF_DEAD(false))
  return;
 uint virtual_gid = GLF_merged2_0_3_62_3_1_13GLF_merged3_0_1_4_1_1_13_2_1_14readsubgroup_sizeworkgroup_basesubgroup_base.xyz.z + GLF_merged2_0_3_62_3_1_13GLF_merged3_0_1_4_1_1_13_2_1_14readsubgroup_sizeworkgroup_basesubgroup_base.w + GLF_merged2_0_1_11_1_1_17subgroup_idsubgroup_local_id.y;
 GLF_merged3_0_1_17_1_1_11_2_1_14subgroup_local_idvirtual_gidworkgroup_base.y = virtual_gid;
 uint next_virtual_gid = GLF_merged2_0_3_62_3_1_13GLF_merged3_0_1_4_1_1_13_2_1_14readsubgroup_sizeworkgroup_basesubgroup_base.xyz.z + GLF_merged2_0_3_62_3_1_13GLF_merged3_0_1_4_1_1_13_2_1_14readsubgroup_sizeworkgroup_basesubgroup_base.w + ((GLF_merged2_0_1_11_1_1_17subgroup_idsubgroup_local_id.y + 1) % GLF_merged2_0_3_62_3_1_13GLF_merged3_0_1_4_1_1_13_2_1_14readsubgroup_sizeworkgroup_basesubgroup_base.xyz.y);
 uint read = atomicLoad(buf[GLF_merged3_0_1_17_1_1_11_2_1_14subgroup_local_idvirtual_gidworkgroup_base.y], 3, 64, 2);
 GLF_merged2_0_3_62_3_1_13GLF_merged3_0_1_4_1_1_13_2_1_14readsubgroup_sizeworkgroup_basesubgroup_base.xyz.x = read;
 if((GLF_merged2_0_1_11_1_1_17subgroup_idsubgroup_local_id.y % 2) == 0)
  {
   if(_GLF_DEAD(_GLF_FALSE(false, (injectionSwitch.x > injectionSwitch.y))))
    return;
   subgroupAll(false);
   for(int _injected_loop_counter = 0; _GLF_WRAPPED_LOOP(_injected_loop_counter != int(_GLF_ONE(1.0, injectionSwitch.y))); _injected_loop_counter ++)
    {
     atomicStore(buf[next_virtual_gid], uint(1), 3, 64, 4);
    }
  }
 else
  {
   subgroupAll(false);
   atomicStore(buf[next_virtual_gid], uint(1), 3, 64, 4);
  }
 subgroupBarrier();
 if(_GLF_DEAD(false))
  return;
 atomicStore(checker[GLF_merged3_0_1_17_1_1_11_2_1_14subgroup_local_idvirtual_gidworkgroup_base.y], GLF_merged2_0_3_62_3_1_13GLF_merged3_0_1_4_1_1_13_2_1_14readsubgroup_sizeworkgroup_basesubgroup_base.xyz.x, 3, 64, 4);
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 2
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END
BUFFER checker DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected_checker DATA_TYPE uint32 SIZE 8388096 FILL 0

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 
  BIND BUFFER checker AS storage DESCRIPTOR_SET 0 BINDING 2 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT checker EQ_BUFFER expected_checker
