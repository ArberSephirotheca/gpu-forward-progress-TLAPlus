   read = atomicLoad(buf[_GLF_IDENTITY(_GLF_IDENTITY(virtual_gid, _GLF_IDENTITY(uint(uvec3(virtual_gid, 0u, 0u)), clamp(uint(uvec3(virtual_gid, 0u, 0u)), _GLF_IDENTITY(uint(uvec3(virtual_gid, 0u, 0u)), ~ (~ (uint(uvec3(virtual_gid, 0u, 0u))))), _GLF_IDENTITY(uint(uvec3(virtual_gid, 0u, 0u)), max(uint(uvec3(virtual_gid, 0u, 0u)), uint(uvec3(virtual_gid, 0u, 0u))))))), max(virtual_gid, _GLF_IDENTITY(virtual_gid, (virtual_gid) << 0u)))], 3, 64, 2);
  }
 subgroupBarrier();
 atomicStore(checker[_GLF_IDENTITY(virtual_gid, min(_GLF_IDENTITY(virtual_gid, uint(_GLF_IDENTITY(uvec4(_GLF_IDENTITY(virtual_gid, clamp(virtual_gid, virtual_gid, virtual_gid)), _GLF_IDENTITY(0u, max(0u, 0u)), 0u, 0u), _GLF_IDENTITY((uvec4(virtual_gid, 0u, 0u, 0u)), ((uvec4(virtual_gid, 0u, 0u, 0u))) + uvec4(_GLF_IDENTITY(0u, (_GLF_IDENTITY(0u, (0u) | 0u)) ^ 0u), 0u, 0u, 0u)) / uvec4(1u, 1u, 1u, 1u)))), virtual_gid))], read, _GLF_IDENTITY(3, (3) | 0), 64, 4);
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 2
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END
BUFFER checker DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected_checker DATA_TYPE uint32 SIZE 8388096 FILL 1

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 
  BIND BUFFER checker AS storage DESCRIPTOR_SET 0 BINDING 2 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT checker EQ_BUFFER expected_checker
