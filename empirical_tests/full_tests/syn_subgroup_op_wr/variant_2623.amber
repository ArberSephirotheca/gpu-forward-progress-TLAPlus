#!amber

DEVICE_FEATURE SubgroupSizeControl.subgroupSizeControl

SET ENGINE_DATA fence_timeout_ms 10000

SHADER compute test GLSL
#version 460
struct _GLF_struct_5 {
 bool _f0;
 mat3x2 _f1;
} ;

struct _GLF_struct_6 {
 _GLF_struct_5 _f0;
 mat2x4 _f1;
 bvec3 _f2;
} ;

struct _GLF_struct_3 {
 vec3 _f0;
 vec4 _f1;
 mat3x2 _f2;
 mat3 _f3;
} ;

struct _GLF_struct_4 {
 bvec2 _f0;
 _GLF_struct_3 _f1;
} ;

struct _GLF_struct_1 {
 uvec3 _f0;
 uvec3 _f1;
 mat4 _f2;
 mat4x3 _f3;
 vec2 _f4;
} ;

struct _GLF_struct_0 {
 bvec3 _f0;
} ;

struct _GLF_struct_2 {
 ivec2 _f0;
 ivec3 _f1;
 _GLF_struct_0 _f2;
 _GLF_struct_1 _f3;
} ;

struct _GLF_struct_7 {
 uint next_virtual_gid;
 mat3x2 _f0;
 _GLF_struct_2 _f1;
 float _f2;
 mat3 _f3;
 _GLF_struct_4 _f4;
 _GLF_struct_6 _f5;
 mat4 _f6;
} ;

layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(set = 0, binding = 2) buffer Checker {
 uint checker[];
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 uvec3 GLF_merged3_0_1_13_1_1_4_2_1_14num_workgroupreadworkgroup_base;
 uvec2 GLF_merged2_0_1_13_1_1_17subgroup_basesubgroup_local_id;
 uint subgroup_id = gl_SubgroupID;
 uint subgroup_size = gl_SubgroupSize;
 uint subgroup_local_id = gl_SubgroupInvocationID;
 GLF_merged2_0_1_13_1_1_17subgroup_basesubgroup_local_id.y = subgroup_local_id;
 uint num_workgroup = gl_NumWorkGroups.x;
 GLF_merged3_0_1_13_1_1_4_2_1_14num_workgroupreadworkgroup_base.x = num_workgroup;
 uint workgroup_size = gl_WorkGroupSize.x;
 uint workgroup_id = gl_WorkGroupID.x;
 uint workgroup_base = workgroup_size * workgroup_id;
 GLF_merged3_0_1_13_1_1_4_2_1_14num_workgroupreadworkgroup_base.z = workgroup_base;
 uint subgroup_base = subgroup_id * subgroup_size;
 GLF_merged2_0_1_13_1_1_17subgroup_basesubgroup_local_id.x = subgroup_base;
 uint virtual_gid = GLF_merged3_0_1_13_1_1_4_2_1_14num_workgroupreadworkgroup_base.z + GLF_merged2_0_1_13_1_1_17subgroup_basesubgroup_local_id.x + GLF_merged2_0_1_13_1_1_17subgroup_basesubgroup_local_id.y;
 _GLF_struct_7 _GLF_struct_replacement_7 = _GLF_struct_7(GLF_merged3_0_1_13_1_1_4_2_1_14num_workgroupreadworkgroup_base.z + GLF_merged2_0_1_13_1_1_17subgroup_basesubgroup_local_id.x + ((GLF_merged2_0_1_13_1_1_17subgroup_basesubgroup_local_id.y + 1) % subgroup_size), mat3x2(1.0), _GLF_struct_2(ivec2(1), ivec3(1), _GLF_struct_0(bvec3(true)), _GLF_struct_1(uvec3(1u), uvec3(1u), mat4(1.0), mat4x3(1.0), vec2(1.0))), 1.0, mat3(1.0), _GLF_struct_4(bvec2(true), _GLF_struct_3(vec3(1.0), vec4(1.0), mat3x2(1.0), mat3(1.0))), _GLF_struct_6(_GLF_struct_5(true, mat3x2(1.0)), mat2x4(1.0), bvec3(true)), mat4(1.0));
 uint read = 0;
 GLF_merged3_0_1_13_1_1_4_2_1_14num_workgroupreadworkgroup_base.y = read;
 atomicStore(buf[_GLF_struct_replacement_7.next_virtual_gid], uint(1), 3, 64, 4);
 if((GLF_merged2_0_1_13_1_1_17subgroup_basesubgroup_local_id.y % 2) == 0)
  {
   subgroupAll(false);
   GLF_merged3_0_1_13_1_1_4_2_1_14num_workgroupreadworkgroup_base.y = atomicLoad(buf[virtual_gid], 3, 64, 2);
  }
 else
  {
   subgroupAll(false);
   GLF_merged3_0_1_13_1_1_4_2_1_14num_workgroupreadworkgroup_base.y = atomicLoad(buf[virtual_gid], 3, 64, 2);
  }
 subgroupBarrier();
 atomicStore(checker[virtual_gid], GLF_merged3_0_1_13_1_1_4_2_1_14num_workgroupreadworkgroup_base.y, 3, 64, 4);
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 2
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END
BUFFER checker DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected_checker DATA_TYPE uint32 SIZE 8388096 FILL 1

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 
  BIND BUFFER checker AS storage DESCRIPTOR_SET 0 BINDING 2 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT checker EQ_BUFFER expected_checker
