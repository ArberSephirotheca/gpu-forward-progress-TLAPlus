};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(set = 0, binding = 2) buffer Checker {
 uint checker[];
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 _GLF_struct_16 _GLF_struct_replacement_16 = _GLF_struct_16(uvec4(1u), gl_SubgroupID, ivec3(1), _GLF_struct_4(_GLF_struct_0(uvec4(1u), bvec3(true), bvec2(true), vec4(1.0)), _GLF_struct_1(mat2x3(1.0), bvec4(true), mat3x4(1.0), mat4x3(1.0), vec3(1.0), true), _GLF_struct_2(mat4x3(1.0), true, mat2(1.0)), mat2(1.0), _GLF_struct_3(uvec4(1u), bvec4(true), mat3x2(1.0), uvec3(1u))), _GLF_struct_10(_GLF_struct_5(ivec2(1), ivec2(1)), _GLF_struct_6(mat4x2(1.0)), _GLF_struct_7(1, mat3x4(1.0)), _GLF_struct_8(uvec4(1u), true, true, mat2x4(1.0), mat2x3(1.0), mat2x3(1.0), mat2(1.0)), bvec4(true), _GLF_struct_9(ivec4(1), mat3x2(1.0))), ivec3(1), _GLF_struct_15(_GLF_struct_11(ivec3(1), vec2(1.0), mat4x3(1.0)), _GLF_struct_12(bvec2(true), bvec2(true), mat3x4(1.0), bvec4(true)), mat3x2(1.0), 1, _GLF_struct_13(ivec2(1), mat3x2(1.0)), mat2(1.0), _GLF_struct_14(mat2(1.0), bvec2(true), vec3(1.0))), mat3x4(1.0));
