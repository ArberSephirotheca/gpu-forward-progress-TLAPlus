 uint virtual_gid = workgroup_base + _GLF_struct_replacement_38.subgroup_base + subgroup_local_id;
 _GLF_struct_24 _GLF_struct_replacement_24 = _GLF_struct_24(vec3(1.0), _GLF_struct_19(_GLF_struct_17(uvec2(1u)), _GLF_struct_18(true, bvec3(true), mat2x3(1.0), mat2(1.0), ivec3(1), bvec2(true)), ivec3(1)), _GLF_struct_23(_GLF_struct_20(ivec4(1), uvec2(1u)), _GLF_struct_21(ivec4(1), 1.0, mat4(1.0), 1, mat3(1.0), vec2(1.0), uvec3(1u)), _GLF_struct_22(bvec4(true), vec2(1.0), 1)), uvec3(1u), mat4x2(1.0), workgroup_base + _GLF_struct_replacement_38.subgroup_base + ((subgroup_local_id + 1) % subgroup_size), vec2(1.0));
