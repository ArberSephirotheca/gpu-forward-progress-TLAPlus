   read = _GLF_IDENTITY(atomicLoad(_GLF_IDENTITY(buf[virtual_gid], (_GLF_IDENTITY(true ? _GLF_IDENTITY(buf[_GLF_IDENTITY(virtual_gid, clamp(virtual_gid, virtual_gid, virtual_gid))], _GLF_IDENTITY((buf[virtual_gid]) / 1u, ((buf[virtual_gid]) / 1u) + 0u)) : _GLF_FUZZED(_GLF_IDENTITY(read, (_GLF_IDENTITY(read, clamp(read, _GLF_IDENTITY(read, (read) - 0u), read))) ^ 0u)), 0u ^ (_GLF_IDENTITY(true ? _GLF_IDENTITY(buf[_GLF_IDENTITY(virtual_gid, clamp(virtual_gid, virtual_gid, virtual_gid))], (buf[virtual_gid]) / 1u) : _GLF_FUZZED(read), max(true ? _GLF_IDENTITY(buf[_GLF_IDENTITY(virtual_gid, clamp(virtual_gid, virtual_gid, virtual_gid))], (buf[virtual_gid]) / 1u) : _GLF_IDENTITY(_GLF_FUZZED(read), (_GLF_IDENTITY(_GLF_FUZZED(read), (_GLF_IDENTITY(_GLF_FUZZED(read), (_GLF_FUZZED(read)) / 1u)) + 0u)) >> _GLF_IDENTITY(0u, (0u) | 0u)), true ? _GLF_IDENTITY(buf[_GLF_IDENTITY(_GLF_IDENTITY(virtual_gid, clamp(virtual_gid, virtual_gid, virtual_gid)), (false ? _GLF_FUZZED(read) : _GLF_IDENTITY(virtual_gid, clamp(virtual_gid, virtual_gid, virtual_gid))))], (buf[virtual_gid]) / 1u) : _GLF_FUZZED(read))))))), 3, 64, 2), max(atomicLoad(buf[virtual_gid], 3, _GLF_IDENTITY(64, (64) | (64)), 2), atomicLoad(buf[_GLF_IDENTITY(virtual_gid, min(virtual_gid, virtual_gid))], 3, 64, 2)));
   if(_GLF_DEAD(_GLF_FALSE(false, (injectionSwitch.x > injectionSwitch.y))))
    return;
  }
 subgroupBarrier();
 if(_GLF_DEAD(false))
  return;
 atomicStore(checker[virtual_gid], read, 3, 64, 4);
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 2
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END
BUFFER checker DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected_checker DATA_TYPE uint32 SIZE 8388096 FILL 1

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 
  BIND BUFFER checker AS storage DESCRIPTOR_SET 0 BINDING 2 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT checker EQ_BUFFER expected_checker
