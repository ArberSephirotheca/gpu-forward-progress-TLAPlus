 _GLF_struct_14 _f3;
 mat2x4 _f4;
} ;

struct _GLF_struct_18 {
 bvec2 _f0;
 mat2 _f1;
 uint subgroup_base;
 _GLF_struct_15 _f2;
 _GLF_struct_17 _f3;
} ;

struct _GLF_struct_11 {
 uint workgroup_id;
 bvec3 _f0;
 uvec2 _f1;
} ;

struct _GLF_struct_9 {
 vec2 _f0;
} ;

struct _GLF_struct_8 {
 mat3x4 _f0;
 bvec2 _f1;
} ;

struct _GLF_struct_7 {
 bvec2 _f0;
} ;

struct _GLF_struct_6 {
 uvec4 _f0;
} ;

struct _GLF_struct_10 {
 _GLF_struct_6 _f0;
 _GLF_struct_7 _f1;
 vec3 _f2;
 mat4 _f3;
 _GLF_struct_8 _f4;
 _GLF_struct_9 _f5;
} ;

struct _GLF_struct_12 {
 mat3 _f0;
 vec2 _f1;
 _GLF_struct_10 _f2;
 ivec3 _f3;
 _GLF_struct_11 _f4;
 vec2 _f5;
} ;

struct _GLF_struct_3 {
 uvec3 _f0;
 bvec4 _f1;
 uvec4 _f2;
 mat3x4 _f3;
 bvec4 _f4;
 vec2 _f5;
 ivec4 _f6;
} ;

struct _GLF_struct_2 {
 mat2x4 _f0;
 uint subgroup_id;
 mat3x4 _f1;
 bvec4 _f2;
 uvec2 _f3;
 ivec3 _f4;
 uvec4 _f5;
 mat4x2 _f6;
} ;

struct _GLF_struct_4 {
 _GLF_struct_2 _f0;
 _GLF_struct_3 _f1;
} ;

struct _GLF_struct_0 {
 mat2x4 _f0;
 mat4x2 _f1;
} ;

struct _GLF_struct_1 {
 _GLF_struct_0 _f0;
 bvec3 _f1;
} ;

struct _GLF_struct_5 {
 _GLF_struct_1 _f0;
 mat2x4 _f1;
 ivec2 _f2;
 uvec3 _f3;
 _GLF_struct_4 _f4;
 uint _f5;
} ;

layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(set = 0, binding = 2) buffer Checker {
 uint checker[];
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 _GLF_struct_5 _GLF_struct_replacement_5 = _GLF_struct_5(_GLF_struct_1(_GLF_struct_0(mat2x4(1.0), mat4x2(1.0)), bvec3(true)), mat2x4(1.0), ivec2(1), uvec3(1u), _GLF_struct_4(_GLF_struct_2(mat2x4(1.0), gl_SubgroupID, mat3x4(1.0), bvec4(true), uvec2(1u), ivec3(1), uvec4(1u), mat4x2(1.0)), _GLF_struct_3(uvec3(1u), bvec4(true), uvec4(1u), mat3x4(1.0), bvec4(true), vec2(1.0), ivec4(1))), 1u);
 uint subgroup_size = gl_SubgroupSize;
 uint subgroup_local_id = gl_SubgroupInvocationID;
 uint num_workgroup = gl_NumWorkGroups.x;
 uint workgroup_size = gl_WorkGroupSize.x;
 _GLF_struct_12 _GLF_struct_replacement_12 = _GLF_struct_12(mat3(1.0), vec2(1.0), _GLF_struct_10(_GLF_struct_6(uvec4(1u)), _GLF_struct_7(bvec2(true)), vec3(1.0), mat4(1.0), _GLF_struct_8(mat3x4(1.0), bvec2(true)), _GLF_struct_9(vec2(1.0))), ivec3(1), _GLF_struct_11(gl_WorkGroupID.x, bvec3(true), uvec2(1u)), vec2(1.0));
 _GLF_struct_23 _GLF_struct_replacement_23 = _GLF_struct_23(uvec2(1u), _GLF_struct_20(bvec3(true), _GLF_struct_19(1u, workgroup_size * _GLF_struct_replacement_12._f4.workgroup_id, vec4(1.0), ivec2(1)), ivec3(1), bvec2(true)), _GLF_struct_22(mat4x3(1.0), _GLF_struct_21(ivec4(1), mat2x3(1.0))), true);
 _GLF_struct_18 _GLF_struct_replacement_18 = _GLF_struct_18(bvec2(true), mat2(1.0), _GLF_struct_replacement_5._f4._f0.subgroup_id * subgroup_size, _GLF_struct_15(_GLF_struct_13(bvec2(true), mat4(1.0)), true, ivec4(1), _GLF_struct_14(1.0, mat3(1.0), mat4x2(1.0), ivec4(1), vec4(1.0)), mat2x4(1.0)), _GLF_struct_17(1.0, mat4x3(1.0), _GLF_struct_16(mat2(1.0), vec2(1.0))));
 uint virtual_gid = _GLF_struct_replacement_23._f1._f1.workgroup_base + _GLF_struct_replacement_18.subgroup_base + subgroup_local_id;
 uint next_virtual_gid = _GLF_struct_replacement_23._f1._f1.workgroup_base + _GLF_struct_replacement_18.subgroup_base + ((subgroup_local_id + 1) % subgroup_size);
 uint read = 0;
 atomicStore(buf[next_virtual_gid], uint(1), 3, 64, 4);
 for(int _injected_loop_counter = 1; _GLF_WRAPPED_LOOP(_injected_loop_counter > 0); _injected_loop_counter --)
  {
   if((subgroup_local_id % 2) == 0)
    {
     do
      {
       subgroupAll(false);
      }
     while(_GLF_WRAPPED_LOOP(false));
     for(int _injected_loop_counter = 0; _GLF_WRAPPED_LOOP(_injected_loop_counter != 1); _injected_loop_counter ++)
      {
       if(_GLF_WRAPPED_IF_TRUE(true))
        {
         read = atomicLoad(buf[virtual_gid], 3, 64, 2);
        }
       else
        {
        }
      }
    }
   else
    {
     subgroupAll(false);
     read = atomicLoad(buf[virtual_gid], 3, 64, 2);
    }
  }
 for(int _injected_loop_counter = int(_GLF_ZERO(0.0, injectionSwitch.x)); _GLF_WRAPPED_LOOP(_injected_loop_counter < 1); _injected_loop_counter ++)
  {
   do
    {
     for(int _injected_loop_counter = 0; _GLF_WRAPPED_LOOP(_injected_loop_counter < 1); _injected_loop_counter ++)
      {
       for(int _injected_loop_counter = 1; _GLF_WRAPPED_LOOP(_injected_loop_counter != int(_GLF_ZERO(0.0, injectionSwitch.x))); _injected_loop_counter --)
        {
         subgroupBarrier();
        }
      }
    }
   while(_GLF_WRAPPED_LOOP(false));
  }
 for(int _injected_loop_counter = _GLF_IDENTITY(0, (0) >> 0); _GLF_WRAPPED_LOOP(_injected_loop_counter < 1); _injected_loop_counter ++)
  {
   for(int _injected_loop_counter = (0 >> _GLF_IDENTITY(int(6), int(6))); _GLF_WRAPPED_LOOP(_injected_loop_counter < 1); _injected_loop_counter ++)
    {
     atomicStore(checker[virtual_gid], read, 3, 64, 4);
    }
  }
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 2
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END
BUFFER checker DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected_checker DATA_TYPE uint32 SIZE 8388096 FILL 1

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 
  BIND BUFFER checker AS storage DESCRIPTOR_SET 0 BINDING 2 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT checker EQ_BUFFER expected_checker
