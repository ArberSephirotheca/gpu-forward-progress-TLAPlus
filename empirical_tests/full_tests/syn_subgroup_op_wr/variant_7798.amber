 ivec2 _f3;
 uvec2 _f4;
} ;

struct _GLF_struct_6 {
 vec4 _f0;
} ;

struct _GLF_struct_9 {
 ivec4 _f0;
 _GLF_struct_6 _f1;
 _GLF_struct_7 _f2;
 mat3x2 _f3;
 _GLF_struct_8 _f4;
 uvec2 _f5;
 ivec4 _f6;
} ;

struct _GLF_struct_4 {
 ivec3 _f0;
 mat3x2 _f1;
 mat4x3 _f2;
 vec3 _f3;
 mat2x3 _f4;
} ;

struct _GLF_struct_3 {
 uint virtual_gid;
 uint _f0;
 ivec3 _f1;
 mat4x3 _f2;
} ;

struct _GLF_struct_5 {
 uvec3 _f0;
 _GLF_struct_3 _f1;
 _GLF_struct_4 _f2;
 uint _f3;
 uvec2 _f4;
} ;

struct _GLF_struct_1 {
 bvec3 _f0;
 vec2 _f1;
} ;

struct _GLF_struct_0 {
 ivec4 _f0;
 mat4x3 _f1;
} ;

struct _GLF_struct_2 {
 mat4x2 _f0;
 _GLF_struct_0 _f1;
 _GLF_struct_1 _f2;
} ;

struct _GLF_struct_10 {
 _GLF_struct_2 _f0;
 mat3x4 _f1;
 ivec3 _f2;
 uint _f3;
 _GLF_struct_5 _f4;
 _GLF_struct_9 _f5;
} ;

layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(set = 0, binding = 2) buffer Checker {
 uint checker[];
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 uvec2 GLF_merged2_0_1_14_1_1_12workgroup_baseworkgroup_id;
 uvec4 GLF_merged4_0_1_16_1_1_13_2_1_4_3_1_11next_virtual_gidnum_workgroupreadsubgroup_id;
 uint subgroup_id = gl_SubgroupID;
 GLF_merged4_0_1_16_1_1_13_2_1_4_3_1_11next_virtual_gidnum_workgroupreadsubgroup_id.w = subgroup_id;
 uint subgroup_size = gl_SubgroupSize;
 uint subgroup_local_id = gl_SubgroupInvocationID;
 uint num_workgroup = gl_NumWorkGroups.x;
 GLF_merged4_0_1_16_1_1_13_2_1_4_3_1_11next_virtual_gidnum_workgroupreadsubgroup_id.y = num_workgroup;
 uint workgroup_size = gl_WorkGroupSize.x;
 uint workgroup_id = gl_WorkGroupID.x;
 GLF_merged2_0_1_14_1_1_12workgroup_baseworkgroup_id.y = workgroup_id;
 uint workgroup_base = workgroup_size * GLF_merged2_0_1_14_1_1_12workgroup_baseworkgroup_id.y;
 GLF_merged2_0_1_14_1_1_12workgroup_baseworkgroup_id.x = workgroup_base;
 uint subgroup_base = GLF_merged4_0_1_16_1_1_13_2_1_4_3_1_11next_virtual_gidnum_workgroupreadsubgroup_id.w * subgroup_size;
 _GLF_struct_10 _GLF_struct_replacement_10 = _GLF_struct_10(_GLF_struct_2(mat4x2(1.0), _GLF_struct_0(ivec4(1), mat4x3(1.0)), _GLF_struct_1(bvec3(true), vec2(1.0))), mat3x4(1.0), ivec3(1), 1u, _GLF_struct_5(uvec3(1u), _GLF_struct_3(GLF_merged2_0_1_14_1_1_12workgroup_baseworkgroup_id.x + subgroup_base + subgroup_local_id, 1u, ivec3(1), mat4x3(1.0)), _GLF_struct_4(ivec3(1), mat3x2(1.0), mat4x3(1.0), vec3(1.0), mat2x3(1.0)), 1u, uvec2(1u)), _GLF_struct_9(ivec4(1), _GLF_struct_6(vec4(1.0)), _GLF_struct_7(ivec3(1), uvec3(1u), mat3x2(1.0), ivec2(1), uvec2(1u)), mat3x2(1.0), _GLF_struct_8(mat3x2(1.0), ivec3(1), vec4(1.0)), uvec2(1u), ivec4(1)));
 uint next_virtual_gid = GLF_merged2_0_1_14_1_1_12workgroup_baseworkgroup_id.x + subgroup_base + ((subgroup_local_id + 1) % subgroup_size);
 GLF_merged4_0_1_16_1_1_13_2_1_4_3_1_11next_virtual_gidnum_workgroupreadsubgroup_id.x = next_virtual_gid;
 uint read = 0;
 GLF_merged4_0_1_16_1_1_13_2_1_4_3_1_11next_virtual_gidnum_workgroupreadsubgroup_id.z = read;
 atomicStore(buf[GLF_merged4_0_1_16_1_1_13_2_1_4_3_1_11next_virtual_gidnum_workgroupreadsubgroup_id.x], uint(1), 3, 64, 4);
 if((subgroup_local_id % 2) == 0)
  {
   subgroupAll(false);
   GLF_merged4_0_1_16_1_1_13_2_1_4_3_1_11next_virtual_gidnum_workgroupreadsubgroup_id.z = atomicLoad(buf[_GLF_struct_replacement_10._f4._f1.virtual_gid], 3, 64, 2);
  }
 else
  {
   subgroupAll(false);
   GLF_merged4_0_1_16_1_1_13_2_1_4_3_1_11next_virtual_gidnum_workgroupreadsubgroup_id.z = atomicLoad(buf[_GLF_struct_replacement_10._f4._f1.virtual_gid], 3, 64, 2);
  }
 subgroupBarrier();
 atomicStore(checker[_GLF_struct_replacement_10._f4._f1.virtual_gid], GLF_merged4_0_1_16_1_1_13_2_1_4_3_1_11next_virtual_gidnum_workgroupreadsubgroup_id.z, 3, 64, 4);
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 2
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END
BUFFER checker DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected_checker DATA_TYPE uint32 SIZE 8388096 FILL 1

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 
  BIND BUFFER checker AS storage DESCRIPTOR_SET 0 BINDING 2 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT checker EQ_BUFFER expected_checker
