 vec2 _f1;
 mat4x2 _f2;
} ;

struct _GLF_struct_8 {
 _GLF_struct_7 _f0;
} ;

struct _GLF_struct_5 {
 mat3 _f0;
} ;

struct _GLF_struct_4 {
 mat4x2 _f0;
 mat2 _f1;
} ;

struct _GLF_struct_3 {
 uint _f0;
} ;

struct _GLF_struct_2 {
 mat4 _f0;
 mat2x4 _f1;
 vec4 _f2;
 mat3 _f3;
 mat2 _f4;
} ;

struct _GLF_struct_6 {
 _GLF_struct_2 _f0;
 _GLF_struct_3 _f1;
 _GLF_struct_4 _f2;
 _GLF_struct_5 _f3;
 mat3x2 _f4;
} ;

struct _GLF_struct_0 {
 uvec2 _f0;
 vec2 _f1;
 mat3 _f2;
 bvec2 _f3;
} ;

struct _GLF_struct_1 {
 _GLF_struct_0 _f0;
 int _f1;
 ivec3 _f2;
 bool _f3;
} ;

struct _GLF_struct_11 {
 _GLF_struct_1 _f0;
 uint workgroup_size;
 _GLF_struct_6 _f1;
 _GLF_struct_8 _f2;
 _GLF_struct_10 _f3;
} ;

layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(set = 0, binding = 2) buffer Checker {
 uint checker[];
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 uvec2 GLF_merged2_0_1_11_1_1_12virtual_gidworkgroup_id;
 uvec2 GLF_merged2_0_1_13_1_1_14subgroup_baseworkgroup_size;
 uvec4 GLF_merged4_0_1_13_1_1_4_2_1_11_3_1_13num_workgroupreadsubgroup_idsubgroup_size;
 uint subgroup_id = gl_SubgroupID;
 GLF_merged4_0_1_13_1_1_4_2_1_11_3_1_13num_workgroupreadsubgroup_idsubgroup_size.z = subgroup_id;
 uint subgroup_size = gl_SubgroupSize;
 GLF_merged4_0_1_13_1_1_4_2_1_11_3_1_13num_workgroupreadsubgroup_idsubgroup_size.w = subgroup_size;
 uint subgroup_local_id = gl_SubgroupInvocationID;
 uint num_workgroup = gl_NumWorkGroups.x;
 GLF_merged4_0_1_13_1_1_4_2_1_11_3_1_13num_workgroupreadsubgroup_idsubgroup_size.x = num_workgroup;
 _GLF_struct_11 _GLF_struct_replacement_11 = _GLF_struct_11(_GLF_struct_1(_GLF_struct_0(uvec2(1u), vec2(1.0), mat3(1.0), bvec2(true)), 1, ivec3(1), true), gl_WorkGroupSize.x, _GLF_struct_6(_GLF_struct_2(mat4(1.0), mat2x4(1.0), vec4(1.0), mat3(1.0), mat2(1.0)), _GLF_struct_3(1u), _GLF_struct_4(mat4x2(1.0), mat2(1.0)), _GLF_struct_5(mat3(1.0)), mat3x2(1.0)), _GLF_struct_8(_GLF_struct_7(vec3(1.0), vec2(1.0), mat4x2(1.0))), _GLF_struct_10(vec4(1.0), bvec4(true), _GLF_struct_9(ivec2(1), uvec4(1u))));
 GLF_merged2_0_1_13_1_1_14subgroup_baseworkgroup_size.y = _GLF_struct_replacement_11.workgroup_size;
 uint workgroup_id = gl_WorkGroupID.x;
 GLF_merged2_0_1_11_1_1_12virtual_gidworkgroup_id.y = workgroup_id;
 uint workgroup_base = GLF_merged2_0_1_13_1_1_14subgroup_baseworkgroup_size.y * GLF_merged2_0_1_11_1_1_12virtual_gidworkgroup_id.y;
 uint subgroup_base = GLF_merged4_0_1_13_1_1_4_2_1_11_3_1_13num_workgroupreadsubgroup_idsubgroup_size.z * GLF_merged4_0_1_13_1_1_4_2_1_11_3_1_13num_workgroupreadsubgroup_idsubgroup_size.w;
 GLF_merged2_0_1_13_1_1_14subgroup_baseworkgroup_size.x = subgroup_base;
 uint virtual_gid = workgroup_base + GLF_merged2_0_1_13_1_1_14subgroup_baseworkgroup_size.x + subgroup_local_id;
 GLF_merged2_0_1_11_1_1_12virtual_gidworkgroup_id.x = virtual_gid;
 uint next_virtual_gid = workgroup_base + GLF_merged2_0_1_13_1_1_14subgroup_baseworkgroup_size.x + ((subgroup_local_id + 1) % GLF_merged4_0_1_13_1_1_4_2_1_11_3_1_13num_workgroupreadsubgroup_idsubgroup_size.w);
 uint read = 0;
 GLF_merged4_0_1_13_1_1_4_2_1_11_3_1_13num_workgroupreadsubgroup_idsubgroup_size.y = read;
 atomicStore(buf[next_virtual_gid], uint(1), 3, 64, 4);
 if((subgroup_local_id % 2) == 0)
  {
   subgroupAll(false);
   GLF_merged4_0_1_13_1_1_4_2_1_11_3_1_13num_workgroupreadsubgroup_idsubgroup_size.y = atomicLoad(buf[GLF_merged2_0_1_11_1_1_12virtual_gidworkgroup_id.x], 3, 64, 2);
  }
 else
  {
   subgroupAll(false);
   GLF_merged4_0_1_13_1_1_4_2_1_11_3_1_13num_workgroupreadsubgroup_idsubgroup_size.y = atomicLoad(buf[GLF_merged2_0_1_11_1_1_12virtual_gidworkgroup_id.x], 3, 64, 2);
  }
 subgroupBarrier();
 atomicStore(checker[GLF_merged2_0_1_11_1_1_12virtual_gidworkgroup_id.x], GLF_merged4_0_1_13_1_1_4_2_1_11_3_1_13num_workgroupreadsubgroup_idsubgroup_size.y, 3, 64, 4);
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 2
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END
BUFFER checker DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected_checker DATA_TYPE uint32 SIZE 8388096 FILL 1

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 
  BIND BUFFER checker AS storage DESCRIPTOR_SET 0 BINDING 2 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT checker EQ_BUFFER expected_checker
