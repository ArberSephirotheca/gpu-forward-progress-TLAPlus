   atomicStore(buf[_GLF_IDENTITY(next_virtual_gid, (next_virtual_gid) | _GLF_IDENTITY((next_virtual_gid), ((next_virtual_gid)) << 0u))], uint(2), 3, 64, _GLF_IDENTITY(_GLF_IDENTITY(4, (4) | 0), ~ (_GLF_IDENTITY(~ (_GLF_IDENTITY(_GLF_IDENTITY(_GLF_IDENTITY(4, (false ? _GLF_FUZZED(-22371) : 4)), (4) | 0), min(_GLF_IDENTITY(_GLF_IDENTITY(4, (false ? _GLF_FUZZED(-22371) : 4)), (4) | 0), _GLF_IDENTITY(_GLF_IDENTITY(4, (false ? _GLF_FUZZED(-22371) : 4)), (4) | 0)))), (~ (_GLF_IDENTITY(4, (4) | 0))) + (_GLF_IDENTITY(0, max(0, _GLF_IDENTITY(0, min(0, 0)))) | 0)))));
