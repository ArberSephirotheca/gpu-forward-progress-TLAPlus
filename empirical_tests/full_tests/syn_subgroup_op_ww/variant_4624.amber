#!amber

DEVICE_FEATURE SubgroupSizeControl.subgroupSizeControl

SET ENGINE_DATA fence_timeout_ms 10000

SHADER compute test GLSL
#version 460
struct _GLF_struct_17 {
 bool _f0;
 uvec4 _f1;
 uint _f2;
} ;

struct _GLF_struct_18 {
 bvec3 _f0;
 _GLF_struct_17 _f1;
 bvec2 _f2;
 bool _f3;
} ;

struct _GLF_struct_16 {
 uvec3 _f0;
} ;

struct _GLF_struct_14 {
 bvec3 _f0;
 int _f1;
} ;

struct _GLF_struct_15 {
 float _f0;
 mat3x2 _f1;
 _GLF_struct_14 _f2;
 uint _f3;
} ;

struct _GLF_struct_12 {
 int _f0;
 mat2 _f1;
 mat2 _f2;
 uint _f3;
 vec4 _f4;
 ivec2 _f5;
} ;

struct _GLF_struct_13 {
 mat2 _f0;
 bvec3 _f1;
 _GLF_struct_12 _f2;
} ;

struct _GLF_struct_19 {
 mat2x4 _f0;
 mat4 _f1;
 _GLF_struct_13 _f2;
 _GLF_struct_15 _f3;
 _GLF_struct_16 _f4;
 _GLF_struct_18 _f5;
 mat4x2 _f6;
 uint subgroup_base;
} ;

struct _GLF_struct_9 {
 uvec3 _f0;
} ;

struct _GLF_struct_8 {
 int _f0;
 float _f1;
 uint _f2;
 mat4 _f3;
} ;

struct _GLF_struct_10 {
 _GLF_struct_8 _f0;
 uvec4 _f1;
 mat4 _f2;
 _GLF_struct_9 _f3;
 ivec4 _f4;
} ;

struct _GLF_struct_11 {
 uint workgroup_size;
 _GLF_struct_10 _f0;
} ;

struct _GLF_struct_5 {
 uvec3 _f0;
 bvec4 _f1;
 mat3 _f2;
 mat2x4 _f3;
 bvec4 _f4;
} ;

struct _GLF_struct_4 {
 vec3 _f0;
 mat2x3 _f1;
} ;

struct _GLF_struct_6 {
 _GLF_struct_4 _f0;
 vec2 _f1;
 _GLF_struct_5 _f2;
 vec4 _f3;
} ;

struct _GLF_struct_7 {
 int _f0;
 mat2x3 _f1;
 uint num_workgroup;
 _GLF_struct_6 _f2;
 vec2 _f3;
} ;

struct _GLF_struct_1 {
 mat2x4 _f0;
 bvec4 _f1;
 mat2x3 _f2;
 ivec3 _f3;
 float _f4;
} ;

struct _GLF_struct_0 {
 mat3x2 _f0;
} ;

struct _GLF_struct_2 {
 mat4x3 _f0;
 _GLF_struct_0 _f1;
 _GLF_struct_1 _f2;
} ;

struct _GLF_struct_3 {
 uint next_virtual_gid;
 bvec2 _f0;
 _GLF_struct_2 _f1;
 uvec3 _f2;
 uvec2 _f3;
} ;

layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 uint subgroup_id = gl_SubgroupID;
 uint subgroup_size = gl_SubgroupSize;
 uint subgroup_local_id = gl_SubgroupInvocationID;
 _GLF_struct_7 _GLF_struct_replacement_7 = _GLF_struct_7(1, mat2x3(1.0), gl_NumWorkGroups.x, _GLF_struct_6(_GLF_struct_4(vec3(1.0), mat2x3(1.0)), vec2(1.0), _GLF_struct_5(uvec3(1u), bvec4(true), mat3(1.0), mat2x4(1.0), bvec4(true)), vec4(1.0)), vec2(1.0));
 _GLF_struct_11 _GLF_struct_replacement_11 = _GLF_struct_11(gl_WorkGroupSize.x, _GLF_struct_10(_GLF_struct_8(1, 1.0, 1u, mat4(1.0)), uvec4(1u), mat4(1.0), _GLF_struct_9(uvec3(1u)), ivec4(1)));
 uint workgroup_id = gl_WorkGroupID.x;
 uint workgroup_base = _GLF_struct_replacement_11.workgroup_size * workgroup_id;
 _GLF_struct_19 _GLF_struct_replacement_19 = _GLF_struct_19(mat2x4(1.0), mat4(1.0), _GLF_struct_13(mat2(1.0), bvec3(true), _GLF_struct_12(1, mat2(1.0), mat2(1.0), 1u, vec4(1.0), ivec2(1))), _GLF_struct_15(1.0, mat3x2(1.0), _GLF_struct_14(bvec3(true), 1), 1u), _GLF_struct_16(uvec3(1u)), _GLF_struct_18(bvec3(true), _GLF_struct_17(true, uvec4(1u), 1u), bvec2(true), true), mat4x2(1.0), subgroup_id * subgroup_size);
 uint virtual_gid = workgroup_base + _GLF_struct_replacement_19.subgroup_base + subgroup_local_id;
 _GLF_struct_3 _GLF_struct_replacement_3 = _GLF_struct_3(workgroup_base + _GLF_struct_replacement_19.subgroup_base + ((subgroup_local_id + 1) % subgroup_size), bvec2(true), _GLF_struct_2(mat4x3(1.0), _GLF_struct_0(mat3x2(1.0)), _GLF_struct_1(mat2x4(1.0), bvec4(true), mat2x3(1.0), ivec3(1), 1.0)), uvec3(1u), uvec2(1u));
 atomicStore(buf[virtual_gid], uint(1), 3, 64, 4);
 if((subgroup_local_id % 2) == 0)
  {
   subgroupAll(true);
   atomicStore(buf[_GLF_struct_replacement_3.next_virtual_gid], uint(2), 3, 64, 4);
  }
 else
  {
   subgroupAll(false);
   atomicStore(buf[_GLF_struct_replacement_3.next_virtual_gid], uint(2), 3, 64, 4);
  }
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 2
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT tester EQ_BUFFER expected
