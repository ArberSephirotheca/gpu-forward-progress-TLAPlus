   atomicStore(buf[next_virtual_gid], uint(2), 3, _GLF_IDENTITY(_GLF_IDENTITY(64, (64) - 0), clamp(_GLF_IDENTITY(64, ~ (~ (64))), 64, 64)), _GLF_IDENTITY(4, max(4, 4)));
