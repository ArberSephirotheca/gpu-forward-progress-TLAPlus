   atomicStore(buf[_GLF_IDENTITY(_GLF_IDENTITY(next_virtual_gid, (next_virtual_gid) << 0u), (_GLF_IDENTITY(next_virtual_gid, ~ _GLF_IDENTITY((~ (next_virtual_gid)), _GLF_IDENTITY(0u, uint(_GLF_ZERO(0.0, injectionSwitch.x)) | (0u)) + ((~ (next_virtual_gid)))))) ^ _GLF_IDENTITY(0u, ~ (~ (_GLF_IDENTITY(0u, (0u) << 0u)))))], _GLF_IDENTITY(uint(2), _GLF_IDENTITY((uint(2)) << 0u, (_GLF_IDENTITY((uint(2)) << 0u, ~ (~ (_GLF_IDENTITY((uint(2)) << 0u, 0u | (_GLF_IDENTITY((uint(_GLF_IDENTITY(2, clamp(2, 2, _GLF_IDENTITY(2, int(_GLF_IDENTITY(ivec2(_GLF_IDENTITY(2, 0 ^ (2)), 1), ivec2(_GLF_IDENTITY(0, (_GLF_IDENTITY(0, int(ivec4(0, 0, 0, ((1 << _GLF_IDENTITY(int(4), int(4))) >> _GLF_IDENTITY(int(4), int(4))))))) / ((1 << _GLF_IDENTITY(int(3), int(3))) >> _GLF_IDENTITY(int(3), int(3)))), 0) ^ (ivec2(_GLF_IDENTITY(2, 0 ^ (2)), 1))))))))) << 0u, (0u ^ 0u) | _GLF_IDENTITY(((_GLF_IDENTITY(uint(2), (true ? uint(2) : _GLF_FUZZED(next_virtual_gid)))) << _GLF_IDENTITY(0u, (_GLF_IDENTITY(0u, (true ? _GLF_IDENTITY(0u, (0u) ^ 0u) : _GLF_FUZZED(num_workgroup)))) << 0u)), (((uint(2)) << 0u)) | 0u)))))))) << 0u)), 3, 64, 4);
