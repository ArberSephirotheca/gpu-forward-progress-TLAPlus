 uint workgroup_base = GLF_merged2_0_3_75_3_1_16GLF_merged3_0_1_16_1_1_13_2_1_14next_virtual_gidsubgroup_baseworkgroup_sizenext_virtual_gid.xyz.z * workgroup_id;
 GLF_merged4_0_1_13_1_1_13_2_1_11_3_1_14subgroup_basesubgroup_sizevirtual_gidworkgroup_base.w = workgroup_base;
