#!amber

DEVICE_FEATURE SubgroupSizeControl.subgroupSizeControl

SET ENGINE_DATA fence_timeout_ms 10000

SHADER compute test GLSL
#version 460
struct _GLF_struct_15 {
 bvec4 _f0;
} ;

struct _GLF_struct_13 {
 ivec4 _f0;
 uvec2 _f1;
 mat4x2 _f2;
 mat3 _f3;
 uint _f4;
 bool _f5;
} ;

struct _GLF_struct_14 {
 bvec4 _f0;
 _GLF_struct_13 _f1;
 ivec3 _f2;
 uint _f3;
} ;

struct _GLF_struct_16 {
 mat3 _f0;
 bvec4 _f1;
 _GLF_struct_14 _f2;
 mat4x2 _f3;
 uint workgroup_id;
 mat2x4 _f4;
 _GLF_struct_15 _f5;
 uint _f6;
} ;

struct _GLF_struct_10 {
 mat4 _f0;
 vec3 _f1;
 vec4 _f2;
 ivec3 _f3;
} ;

struct _GLF_struct_9 {
 uint _f0;
} ;

struct _GLF_struct_8 {
 int _f0;
 mat2 _f1;
 mat2x3 _f2;
 mat2x3 _f3;
} ;

struct _GLF_struct_11 {
 int _f0;
 _GLF_struct_8 _f1;
 mat4 _f2;
 mat2x3 _f3;
 _GLF_struct_9 _f4;
 _GLF_struct_10 _f5;
} ;

struct _GLF_struct_6 {
 mat3 _f0;
 bvec3 _f1;
 vec4 _f2;
} ;

struct _GLF_struct_5 {
 bvec3 _f0;
 bvec4 _f1;
} ;

struct _GLF_struct_4 {
 int _f0;
 bvec2 _f1;
 bvec4 _f2;
} ;

struct _GLF_struct_3 {
 mat4 _f0;
 float _f1;
 mat3 _f2;
 ivec3 _f3;
 mat4 _f4;
 vec3 _f5;
} ;

struct _GLF_struct_7 {
 _GLF_struct_3 _f0;
 _GLF_struct_4 _f1;
 uint _f2;
 ivec2 _f3;
 _GLF_struct_5 _f4;
 _GLF_struct_6 _f5;
} ;

struct _GLF_struct_1 {
 uvec2 _f0;
 bvec2 _f1;
 ivec4 _f2;
 vec3 _f3;
 mat2 _f4;
} ;

struct _GLF_struct_0 {
 vec4 _f0;
 uvec2 _f1;
 mat3 _f2;
 bvec3 _f3;
 vec3 _f4;
 bool _f5;
} ;

struct _GLF_struct_2 {
 _GLF_struct_0 _f0;
 uvec2 _f1;
 bvec4 _f2;
 _GLF_struct_1 _f3;
} ;

struct _GLF_struct_12 {
 _GLF_struct_2 _f0;
 vec3 _f1;
 uint workgroup_base;
 _GLF_struct_7 _f2;
 ivec3 _f3;
 bool _f4;
 _GLF_struct_11 _f5;
} ;

layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 uint subgroup_id = gl_SubgroupID;
 uint subgroup_size = gl_SubgroupSize;
 uint subgroup_local_id = gl_SubgroupInvocationID;
 uint num_workgroup = gl_NumWorkGroups.x;
 uint workgroup_size = gl_WorkGroupSize.x;
 _GLF_struct_16 _GLF_struct_replacement_16 = _GLF_struct_16(mat3(1.0), bvec4(true), _GLF_struct_14(bvec4(true), _GLF_struct_13(ivec4(1), uvec2(1u), mat4x2(1.0), mat3(1.0), 1u, true), ivec3(1), 1u), mat4x2(1.0), gl_WorkGroupID.x, mat2x4(1.0), _GLF_struct_15(bvec4(true)), 1u);
 _GLF_struct_12 _GLF_struct_replacement_12 = _GLF_struct_12(_GLF_struct_2(_GLF_struct_0(vec4(1.0), uvec2(1u), mat3(1.0), bvec3(true), vec3(1.0), true), uvec2(1u), bvec4(true), _GLF_struct_1(uvec2(1u), bvec2(true), ivec4(1), vec3(1.0), mat2(1.0))), vec3(1.0), workgroup_size * _GLF_struct_replacement_16.workgroup_id, _GLF_struct_7(_GLF_struct_3(mat4(1.0), 1.0, mat3(1.0), ivec3(1), mat4(1.0), vec3(1.0)), _GLF_struct_4(1, bvec2(true), bvec4(true)), 1u, ivec2(1), _GLF_struct_5(bvec3(true), bvec4(true)), _GLF_struct_6(mat3(1.0), bvec3(true), vec4(1.0))), ivec3(1), true, _GLF_struct_11(1, _GLF_struct_8(1, mat2(1.0), mat2x3(1.0), mat2x3(1.0)), mat4(1.0), mat2x3(1.0), _GLF_struct_9(1u), _GLF_struct_10(mat4(1.0), vec3(1.0), vec4(1.0), ivec3(1))));
 uint subgroup_base = subgroup_id * subgroup_size;
 uint virtual_gid = _GLF_struct_replacement_12.workgroup_base + subgroup_base + subgroup_local_id;
 uint next_virtual_gid = _GLF_struct_replacement_12.workgroup_base + subgroup_base + ((subgroup_local_id + 1) % subgroup_size);
 atomicStore(buf[virtual_gid], uint(1), 3, 64, 4);
 if((subgroup_local_id % 2) == 0)
  {
   subgroupAll(true);
   atomicStore(buf[next_virtual_gid], uint(2), 3, 64, 4);
  }
 else
  {
   subgroupAll(false);
   atomicStore(buf[next_virtual_gid], uint(2), 3, 64, 4);
  }
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 2
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT tester EQ_BUFFER expected
