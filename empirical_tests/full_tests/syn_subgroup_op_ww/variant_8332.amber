 ivec2 _f0;
 uint _f1;
 vec3 _f2;
} ;

struct _GLF_struct_1 {
 mat4x3 _f0;
 int _f1;
} ;

struct _GLF_struct_6 {
 mat2x3 _f0;
 _GLF_struct_1 _f1;
 _GLF_struct_2 _f2;
 _GLF_struct_3 _f3;
 vec2 _f4;
 _GLF_struct_4 _f5;
 _GLF_struct_5 _f6;
} ;

struct _GLF_struct_0 {
 ivec4 _f0;
} ;

struct _GLF_struct_7 {
 _GLF_struct_0 _f0;
 uint workgroup_base;
 _GLF_struct_6 _f1;
} ;

layout(set = 0, binding = 1) uniform buf1 {
 vec2 injectionSwitch;
};
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_maximal_reconvergence : enable
layout(set = 0, binding = 0) buffer Buf {
 uint buf[];
};
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
void main()
{
 uvec2 GLF_merged2_0_1_11_1_1_17subgroup_idsubgroup_local_id;
 uvec3 GLF_merged3_0_1_16_1_1_13_2_1_11next_virtual_gidnum_workgroupsubgroup_id;
 uint subgroup_id = gl_SubgroupID;
 GLF_merged2_0_1_11_1_1_17subgroup_idsubgroup_local_id.x = subgroup_id;
 GLF_merged3_0_1_16_1_1_13_2_1_11next_virtual_gidnum_workgroupsubgroup_id.z = GLF_merged2_0_1_11_1_1_17subgroup_idsubgroup_local_id.x;
 uint subgroup_size = gl_SubgroupSize;
 uint subgroup_local_id = gl_SubgroupInvocationID;
 GLF_merged2_0_1_11_1_1_17subgroup_idsubgroup_local_id.y = subgroup_local_id;
 uint num_workgroup = gl_NumWorkGroups.x;
 GLF_merged3_0_1_16_1_1_13_2_1_11next_virtual_gidnum_workgroupsubgroup_id.y = num_workgroup;
 uint workgroup_size = gl_WorkGroupSize.x;
 uint workgroup_id = gl_WorkGroupID.x;
 _GLF_struct_7 _GLF_struct_replacement_7 = _GLF_struct_7(_GLF_struct_0(ivec4(1)), workgroup_size * workgroup_id, _GLF_struct_6(mat2x3(1.0), _GLF_struct_1(mat4x3(1.0), 1), _GLF_struct_2(ivec2(1), 1u, vec3(1.0)), _GLF_struct_3(1.0, ivec2(1), uvec4(1u)), vec2(1.0), _GLF_struct_4(bvec2(true)), _GLF_struct_5(1.0, vec2(1.0), mat3x2(1.0), uvec2(1u), bvec4(true), mat2x3(1.0), vec3(1.0))));
 uint subgroup_base = GLF_merged3_0_1_16_1_1_13_2_1_11next_virtual_gidnum_workgroupsubgroup_id.z * subgroup_size;
 uint virtual_gid = _GLF_struct_replacement_7.workgroup_base + subgroup_base + GLF_merged2_0_1_11_1_1_17subgroup_idsubgroup_local_id.y;
 uint next_virtual_gid = _GLF_struct_replacement_7.workgroup_base + subgroup_base + ((GLF_merged2_0_1_11_1_1_17subgroup_idsubgroup_local_id.y + 1) % subgroup_size);
 GLF_merged3_0_1_16_1_1_13_2_1_11next_virtual_gidnum_workgroupsubgroup_id.x = next_virtual_gid;
 atomicStore(buf[virtual_gid], uint(1), 3, 64, 4);
 if((GLF_merged2_0_1_11_1_1_17subgroup_idsubgroup_local_id.y % 2) == 0)
  {
   subgroupAll(true);
   atomicStore(buf[GLF_merged3_0_1_16_1_1_13_2_1_11next_virtual_gidnum_workgroupsubgroup_id.x], uint(2), 3, 64, 4);
