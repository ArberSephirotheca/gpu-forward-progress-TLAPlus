   atomicStore(buf[GLF_merged2_0_3_67_3_1_16GLF_merged3_0_1_13_1_1_11_2_1_11num_workgroupsubgroup_idvirtual_gidnext_virtual_gid.w], uint(_GLF_IDENTITY(2, clamp(2, 2, _GLF_IDENTITY(2, (2) >> 0)))), 3, 64, 4);
