 uint virtual_gid = workgroup_base + subgroup_base + _GLF_struct_replacement_15._f3.subgroup_local_id;
 uint next_virtual_gid = workgroup_base + subgroup_base + ((_GLF_struct_replacement_15._f3.subgroup_local_id + 1) % _GLF_struct_replacement_33.subgroup_size);
 atomicStore(buf[virtual_gid], uint(1), 3, 64, 4);
 if((_GLF_struct_replacement_15._f3.subgroup_local_id % 2) == 0)
  {
   subgroupAll(true);
   atomicStore(buf[next_virtual_gid], uint(2), 3, 64, 4);
