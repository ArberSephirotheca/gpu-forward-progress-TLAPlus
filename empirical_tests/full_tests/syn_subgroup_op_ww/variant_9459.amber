 _GLF_struct_15 _GLF_struct_replacement_15 = _GLF_struct_15(_GLF_struct_9(mat3(1.0), _GLF_struct_7(1u, mat4x3(1.0), mat3x4(1.0)), _GLF_struct_8(bvec3(true), uvec2(1u), uvec3(1u), mat2x3(1.0), mat4(1.0), mat3(1.0), vec4(1.0)), mat3(1.0)), uvec3(1u), _GLF_struct_14(uvec4(1u), mat2x3(1.0), _GLF_struct_10(ivec3(1), gl_WorkGroupSize.x, bvec3(true), bvec3(true), 1.0), _GLF_struct_11(mat4(1.0), ivec4(1), 1.0, mat3(1.0), bvec2(true), mat4x2(1.0), mat4(1.0)), _GLF_struct_12(1, bvec4(true), uvec3(1u), 1.0), _GLF_struct_13(mat4x2(1.0), uvec4(1u), mat2x3(1.0), vec3(1.0), bvec4(true), 1.0, ivec3(1))), true, vec3(1.0));
 uint workgroup_id = gl_WorkGroupID.x;
 _GLF_struct_24 _GLF_struct_replacement_24 = _GLF_struct_24(mat2x4(1.0), _GLF_struct_replacement_15._f2._f2.workgroup_size * workgroup_id, _GLF_struct_18(mat4x3(1.0), mat4(1.0), _GLF_struct_16(ivec3(1), vec2(1.0), bvec2(true)), ivec3(1), _GLF_struct_17(bvec3(true), ivec4(1), vec2(1.0), vec4(1.0)), bvec3(true)), _GLF_struct_20(mat4x2(1.0), _GLF_struct_19(ivec4(1), bvec3(true), mat2x4(1.0), vec2(1.0), mat2(1.0))), _GLF_struct_23(_GLF_struct_21(bvec2(true)), _GLF_struct_22(vec4(1.0), bvec2(true), uvec2(1u), vec2(1.0), mat4x3(1.0), uvec2(1u))));
 uint subgroup_base = subgroup_id * _GLF_struct_replacement_34._f2.subgroup_size;
 uint virtual_gid = _GLF_struct_replacement_24.workgroup_base + subgroup_base + subgroup_local_id;
 uint next_virtual_gid = _GLF_struct_replacement_24.workgroup_base + subgroup_base + ((subgroup_local_id + 1) % _GLF_struct_replacement_34._f2.subgroup_size);
 atomicStore(buf[virtual_gid], uint(1), 3, 64, 4);
 if((subgroup_local_id % 2) == 0)
  {
   subgroupAll(true);
   atomicStore(buf[next_virtual_gid], uint(2), 3, 64, 4);
  }
 else
  {
   subgroupAll(false);
   atomicStore(buf[next_virtual_gid], uint(2), 3, 64, 4);
  }
}

END

BUFFER tester DATA_TYPE uint32 SIZE 8388096 FILL 0
BUFFER expected DATA_TYPE uint32 SIZE 8388096 FILL 2
BUFFER injection DATA_TYPE vec2<float> DATA
 0.0 1.0
END

PIPELINE compute test_pipe
  ATTACH test
  BIND BUFFER tester AS storage DESCRIPTOR_SET 0 BINDING 0 
  BIND BUFFER injection AS uniform DESCRIPTOR_SET 0 BINDING 1 

  SUBGROUP test
	  VARYING_SIZE on
  END
END

RUN test_pipe 65532 1 1
EXPECT tester EQ_BUFFER expected
