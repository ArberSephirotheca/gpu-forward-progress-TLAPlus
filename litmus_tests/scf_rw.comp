#version 460
#pragma scheduler(OBE)
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable

layout(local_size_x = 2) in;
layout(tla_subgroup_size = 2) in;
layout(tla_num_workgroups = 1) in;
layout(tla_synchronization_id = 2) in; // 0=None, 1=SSO, 2=SCF, 3=SM, 4=CM

layout(std430, binding = 0) buffer Partition {
    uint slots;
};

void main() {
    const uint SLOT_WIDTH = 4u;
    const uint SLOT_MASK = (1u << SLOT_WIDTH) - 1u;
    const uint FULL_MASK = (1u << (SLOT_WIDTH * 2u)) - 1u;

    uint tid = gl_LocalInvocationID.x;
    uint ownSlot = tid;
    uint peerSlot = 1u - ownSlot;

    uint snapshot = atomicLoad(slots, 4, 64, 0);
    uint read = (snapshot >> (peerSlot * SLOT_WIDTH)) & SLOT_MASK;

    uint ownShift = ownSlot * SLOT_WIDTH;
    uint ownClearMask = FULL_MASK - (SLOT_MASK << ownShift);
    if (tid == 0u) {
        atomicAnd(slots, ownClearMask, 4, 64, 0);
        atomicOr(slots, (1u << ownShift), 4, 64, 0);
    } else {
        atomicAnd(slots, ownClearMask, 4, 64, 0);
        atomicOr(slots, (1u << ownShift), 4, 64, 0);
    }

    barrier();
    assert(read == 0u);
}
